# Unit Talk Platform - Staging Environment Variables
# Environment configuration for staging deployment and pre-production testing

# =============================================================================
# CORE APPLICATION SETTINGS
# =============================================================================
NODE_ENV=staging
PORT=3000
LOG_LEVEL=info

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Staging Supabase Configuration
SUPABASE_URL_STAGING=https://your-staging-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY_STAGING=your-staging-service-role-key

# Staging PostgreSQL
POSTGRES_PASSWORD_STAGING=your-secure-staging-password
POSTGRES_DB=unit_talk_staging
POSTGRES_USER=postgres

# Temporal Database
TEMPORAL_DB_PASSWORD=your-temporal-db-password

# =============================================================================
# TEMPORAL WORKFLOW ENGINE
# =============================================================================
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=unit-talk-staging
TEMPORAL_TASK_QUEUE=unit-talk-staging

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_URL=redis://localhost:6379

# =============================================================================
# SECURITY & ENCRYPTION
# =============================================================================
JWT_SECRET_STAGING=your-staging-jwt-secret-key-min-32-chars
ENCRYPTION_KEY_STAGING=your-staging-encryption-key-32-chars

# =============================================================================
# DISCORD INTEGRATION (Staging Bot)
# =============================================================================
DISCORD_TOKEN_STAGING=your-staging-discord-bot-token
DISCORD_CLIENT_ID_STAGING=your-staging-discord-client-id
DISCORD_WEBHOOK_URL_STAGING=https://discord.com/api/webhooks/staging-webhook-url
DISCORD_OPERATOR_WEBHOOK_URL_STAGING=https://discord.com/api/webhooks/staging-operator-webhook-url

# =============================================================================
# EXTERNAL API KEYS (Staging/Sandbox)
# =============================================================================
# Staging API Keys (use sandbox/staging keys)
OPTIMAL_API_KEY_STAGING=your-staging-optimal-api-key
SGO_API_KEY_STAGING=your-staging-sgo-api-key

# =============================================================================
# MONITORING & OBSERVABILITY
# =============================================================================
GRAFANA_PASSWORD_STAGING=your-secure-grafana-password

# =============================================================================
# SSL/TLS CONFIGURATION
# =============================================================================
# SSL certificate paths (if using custom certificates)
SSL_CERT_PATH=/etc/nginx/ssl/staging.crt
SSL_KEY_PATH=/etc/nginx/ssl/staging.key

# =============================================================================
# DOMAIN CONFIGURATION
# =============================================================================
# Staging domain configuration
STAGING_DOMAIN=staging.unittalk.com
STAGING_API_DOMAIN=api-staging.unittalk.com
STAGING_GRAFANA_DOMAIN=staging-grafana.unittalk.com

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
# Backup settings for staging
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=7
BACKUP_S3_BUCKET=unit-talk-staging-backups

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================
# Staging-specific performance settings
MAX_CONNECTIONS=100
WORKER_PROCESSES=2
REDIS_MAX_MEMORY=1gb

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Enable/disable features for staging testing
FEATURE_NEW_GRADING_ALGORITHM=true
FEATURE_ENHANCED_ALERTS=true
FEATURE_BETA_UI=true

# =============================================================================
# NOTES FOR STAGING
# =============================================================================
# 1. Use staging-specific Discord channels and webhooks
# 2. API keys should be sandbox/staging versions when available
# 3. SSL certificates should be valid for staging domains
# 4. Monitor resource usage and performance
# 5. Test all production features before promoting to prod