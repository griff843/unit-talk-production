{
  "name": "IngestionAgent",
  "enabled": true,
  "logLevel": "info",
  "providers": [
    {
      "name": "Optimal",
      "enabled": true,
      "url": "https://api.optimal.com",
      "timeout": 30000,
      "retryAttempts": 3,
      "retryDelay": 1000,
      "rateLimit": {
        "requests": 900,
        "window": 3600000
      }
    }
  ],
  "batchSize": 100,
  "processingTimeout": 300000,
  "duplicateCheckEnabled": true,
  "duplicateCheckWindow": 86400000,
  "validationEnabled": true,
  "normalizationEnabled": true
}