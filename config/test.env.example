# UNIT TALK E2E TEST ENVIRONMENT
# Copy this file to .env and fill in your actual values

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# =============================================================================
# API KEYS - PRIMARY AND FALLBACK PROVIDERS
# =============================================================================

# Primary API (Optimal)
OPTIMAL_API_KEY=your-optimal-api-key-here

# Fallback APIs
SGO_API_KEY=your-sgo-api-key-here
ODDS_API_KEY=your-odds-api-key-here

# Additional APIs (optional)
ESPN_API_KEY=your-espn-api-key-here
ROTOBALLER_API_KEY=your-rotoballer-api-key-here

# =============================================================================
# DISCORD WEBHOOKS
# =============================================================================
DISCORD_APPROVED_WEBHOOK_URL=https://discord.com/api/webhooks/your-approved-webhook
DISCORD_OPERATOR_WEBHOOK_URL=https://discord.com/api/webhooks/your-operator-webhook
DISCORD_ALERTS_WEBHOOK_URL=https://discord.com/api/webhooks/your-alerts-webhook

# =============================================================================
# TEMPORAL CONFIGURATION
# =============================================================================
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=unit-talk-local

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
NODE_ENV=development
LOG_LEVEL=info

# =============================================================================
# TEST CONFIGURATION
# =============================================================================
TEST_MODE=true
TEST_LEAGUES=MLB,WNBA,MLS
TEST_CYCLE_DURATION=120000
TEST_MAX_CYCLES=5

# =============================================================================
# MONITORING & HEALTH CHECKS
# =============================================================================
HEALTH_CHECK_INTERVAL=30000
PERFORMANCE_WARNING_THRESHOLD=110000
CRITICAL_ERROR_THRESHOLD=5

# =============================================================================
# API QUOTA LIMITS
# =============================================================================
OPTIMAL_HOURLY_LIMIT=900
SGO_HOURLY_LIMIT=500
ODDS_API_HOURLY_LIMIT=500
QUOTA_WARNING_THRESHOLD=0.8
QUOTA_CRITICAL_THRESHOLD=0.95

# =============================================================================
# DISCORD DELIVERY TARGETS
# =============================================================================
DISCORD_CRITICAL_DELIVERY_TARGET=15000
DISCORD_HIGH_PRIORITY_DELIVERY_TARGET=30000
DISCORD_MEDIUM_PRIORITY_DELIVERY_TARGET=60000

# =============================================================================
# LEAGUE CONFIGURATIONS
# =============================================================================
MLB_LIVE_THRESHOLD=0.5
WNBA_LIVE_THRESHOLD=0.5
MLS_LIVE_THRESHOLD=1.0
NFL_LIVE_THRESHOLD=0.5

# =============================================================================
# USP DETECTION THRESHOLDS
# =============================================================================
STEAM_MOVEMENT_LIVE_THRESHOLD=0.5
STEAM_MOVEMENT_OFFPEAK_THRESHOLD=1.0
STALE_LINE_LIVE_THRESHOLD=300000
STALE_LINE_OFFPEAK_THRESHOLD=600000
HEDGE_PROFIT_THRESHOLD=0.05
MIDDLE_GAP_THRESHOLD=2.0

# =============================================================================
# NOTIFICATION SETTINGS
# =============================================================================
NOTION_API_KEY=your-notion-api-key-here
NOTION_DATABASE_ID=your-notion-database-id-here

# =============================================================================
# SECURITY & AUTHENTICATION
# =============================================================================
JWT_SECRET=your-jwt-secret-here
API_RATE_LIMIT=1000
CORS_ORIGIN=http://localhost:3000