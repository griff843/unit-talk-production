# Test environment configuration

# Database
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=test-anon-key
SUPABASE_SERVICE_ROLE_KEY=test-service-role-key

# AI Services
OPENAI_API_KEY=test-openai-key
ANTHROPIC_API_KEY=test-anthropic-key

# Discord
DISCORD_TOKEN=test-discord-token
DISCORD_CLIENT_ID=test-client-id
DISCORD_GUILD_ID=test-guild-id
DISCORD_ALERT_WEBHOOK=test-alert-webhook
DISCORD_PROMOTION_WEBHOOK=test-promotion-webhook

# Email
CRITICAL_EMAIL_RECIPIENTS=test@example.com
BUSINESS_EMAIL_RECIPIENTS=test@example.com
ALERT_EMAIL_FROM=test@example.com

# SMS (Twilio)
TWILIO_ACCOUNT_SID=test-account-sid
TWILIO_AUTH_TOKEN=test-auth-token
TWILIO_FROM_NUMBER=+1234567890
ONCALL_PHONE_NUMBERS=+1234567890

# External Integrations
EXTERNAL_WEBHOOK_URL=http://localhost:3001/webhook
EXTERNAL_WEBHOOK_TOKEN=test-webhook-token

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
DASHBOARD_PORT=3001

# Performance Tuning
MAX_CONCURRENT_AI_REQUESTS=10
AI_REQUEST_TIMEOUT_MS=30000
ALERT_COOLDOWN_MINUTES=15
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT_MS=60000

# Logging
LOG_LEVEL=error
LOG_FORMAT=json
ENABLE_PERFORMANCE_LOGGING=false

# Feature Flags
ENABLE_CONSENSUS_MODE=true
ENABLE_CIRCUIT_BREAKER=true
ENABLE_PERFORMANCE_TRACKING=true
ENABLE_ADVANCED_ALERTS=true

# Test-specific settings
NODE_ENV=test
METRICS_ENABLED=false
HEALTH_CHECK_INTERVAL=1000
TEST_MODE=true 