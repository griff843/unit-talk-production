{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "sourceMap": false,
    "declaration": false,
    "declarationMap": false,
    "outDir": "./dist",
    // Relax strict unused variable checking for production build
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    // Allow implicit any for gradual type migration
    "noImplicitAny": false,
    // Still maintain core type safety
    "strict": true,
    "strictNullChecks": true
  },
  "exclude": [
    "node_modules",
    "dist",
    "test/**/*",
    "src/test/**/*",
    "**/*.test.ts",
    "**/*.spec.ts",
    "qa/**/*",
    "src/runner/**/*",
    "src/scripts/**/*",
    "src/temporal/**/*",
    "src/workflows/**/*"
  ]
}