# Test Environment Configuration
NODE_ENV=test

# Discord Test Bot
DISCORD_TEST_BOT_TOKEN=your_test_bot_token
TEST_GUILD_ID=your_test_guild_id
TEST_CHANNEL_ID=your_test_channel_id

# Test Database
SUPABASE_TEST_URL=your_test_supabase_url
SUPABASE_TEST_KEY=your_test_supabase_key

# Test Users
TEST_USER_ID=your_test_user_id
TEST_ADMIN_ID=your_test_admin_id
TEST_VIP_USER_ID=your_test_vip_id
TEST_CAPPER_ID=your_test_capper_id

# Test API Keys
TEST_API_KEY=your_test_api_key
TEST_ADMIN_KEY=your_test_admin_key

# Test Endpoints
TEST_API_URL=http://localhost:3001
TEST_WS_URL=ws://localhost:3001

# Test Feature Flags
ENABLE_TEST_MODE=true
SKIP_RATE_LIMITS=true
MOCK_EXTERNAL_SERVICES=true

# Test Timeouts
TEST_TIMEOUT_MS=5000
TEST_RETRY_DELAY_MS=100
TEST_MAX_RETRIES=3

# Test Logging
TEST_LOG_LEVEL=debug
TEST_LOG_FILE=logs/test.log