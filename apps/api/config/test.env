# Test Environment Configuration
NODE_ENV=test

# Discord Test Bot
DISCORD_TEST_BOT_TOKEN=test_bot_token
TEST_GUILD_ID=test_guild_id
TEST_CHANNEL_ID=test_channel_id

# Test Database
SUPABASE_URL=https://test.supabase.co
SUPABASE_SERVICE_ROLE_KEY=test_service_role_key
SUPABASE_KEY=test_key
SUPABASE_ANON_KEY=test_anon_key

# Test Users
TEST_USER_ID=test_user_id
TEST_ADMIN_ID=test_admin_id
TEST_VIP_USER_ID=test_vip_id
TEST_CAPPER_ID=test_capper_id

# Test API Keys
TEST_API_KEY=test_api_key
TEST_ADMIN_KEY=test_admin_key

# Test Endpoints
TEST_API_URL=http://localhost:3001
TEST_WS_URL=ws://localhost:3001

# Test Feature Flags
ENABLE_TEST_MODE=true
SKIP_RATE_LIMITS=true
MOCK_EXTERNAL_SERVICES=true

# Test Timeouts
TEST_TIMEOUT_MS=5000
TEST_RETRY_DELAY_MS=100
TEST_MAX_RETRIES=3

# Test Logging
TEST_LOG_LEVEL=debug
TEST_LOG_FILE=logs/test.log 