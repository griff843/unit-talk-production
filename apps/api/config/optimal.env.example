# Optimal API Configuration
# Get your API key from: https://optimal-bet-api.readme.io/

# Required: Your Optimal API key
OPTIMAL_API_KEY=your_optimal_api_key_here

# Optional: API base URL (defaults to https://api.optimal-bet.com)
OPTIMAL_API_BASE_URL=https://api.optimal-bet.com

# Optional: Enable/disable the Optimal provider (defaults to true)
OPTIMAL_ENABLED=true

# Optional: Rate limiting (defaults to 900 requests per hour)
OPTIMAL_RATE_LIMIT_MAX_REQUESTS=900
OPTIMAL_RATE_LIMIT_WINDOW_MS=3600000

# Optional: Request timeout in milliseconds (defaults to 30000)
OPTIMAL_REQUEST_TIMEOUT=30000

# Optional: Retry configuration
OPTIMAL_RETRY_ATTEMPTS=3
OPTIMAL_RETRY_DELAY=1000