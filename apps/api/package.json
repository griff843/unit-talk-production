{
  "name": "@unit-talk/api",
  "version": "1.0.0",
  "description": "Enterprise-grade betting automation platform",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --project tsconfig.prod.json",
    "build:dev": "tsx --tsconfig ./tsconfig.json src/index.ts --outDir ./dist",
    "build:transpile": "npx tsc --project tsconfig.prod.json --transpileOnly --skipLibCheck --noEmit false",
    "start": "node dist/index.js",
    "start:prod": "npm run build:transpile && node dist/index.js",
    "dev": "tsx --watch src/api-server.ts",
    "start:dev": "tsx src/index.ts",
    "api:dev": "tsx --watch src/api-server.ts",
    "api:start": "node -r ts-node/register/transpile-only -r tsconfig-paths/register src/api-server.ts",
    "api:start:dev-local": "cross-env NODE_ENV=development API_PORT=3020 ALLOW_DEV_UNCONFIGURED=true START_TEMPORAL_WORKER=false PROMETHEUS_ENABLED=true PROMETHEUS_PORT=9464 node -r ts-node/register/transpile-only -r tsconfig-paths/register src/api-server.ts",
    "worker:dev": "tsx --watch src/worker.ts",
    "test": "jest --passWithNoTests --testPathPatterns=^$",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --testPathPattern=integration",
    "test:unit": "jest --testPathPattern=unit",
    "test:smoke": "jest --testPathPattern=smoke/production-flow --verbose",
    "e2e:smoke": "jest --testPathPattern=smoke/production-flow --verbose",
    "lint": "eslint src/api-server.ts src/routes/**/* src/security/**/* src/services/**/* src/utils/**/* --ext .ts,.tsx",
    "lint:fix": "eslint src/api-server.ts src/routes/**/* src/security/**/* src/services/**/* src/utils/**/* --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json}\"",
    "type-check": "npx tsc --noEmit -p tsconfig.prod.json",
    "type-check:watch": "tsc --noEmit --watch -p tsconfig.prod.json",
    "health:check": "node scripts/healthCheck.js",
    "metrics:show": "node scripts/showMetrics.js",
    "agents:test": "tsx src/runner/testAllAgents.ts",
    "agents:monitor": "tsx scripts/healthMonitor.ts",
    "run:approve": "tsx src/runner/runApprovalAgent.ts",
    "run:publish": "tsx src/runner/runAlertAgent.ts",
    "odds-api:test": "tsx scripts/test-odds-api-integration.ts",
    "odds-api:monitor": "tsx scripts/monitor-credit-usage.ts",
    "elite:test": "tsx scripts/test-elite-dual-api.ts",
    "elite:deploy": "tsx scripts/deploy-elite-system.ts",
    "settlement:test": "tsx -e \"import('./src/agents/SettlementAgent').then(m => console.log('Settlement Agent ready'))\"",
    "settlement:migrate": "tsx scripts/run-settlement-migration.ts",
    "settlement:runner": "tsx bin/settlement-runner.ts",
    "settlement:backfill": "tsx bin/settlement-runner.ts backfill",
    "settlement:health": "tsx bin/settlement-runner.ts health",
    "settlement:stats": "tsx bin/settlement-runner.ts stats",
    "db:health": "tsx src/scripts/db-health.ts",
    "db:push:cloud": "tsx src/scripts/db-push-cloud.ts",
    "canary": "tsx src/scripts/ops/canary.ts",
    "e2e": "tsx src/scripts/e2e/everything.ts",
    "e2e:verify": "tsx src/scripts/e2e/verifyCloud.ts",
    "props:mlb:ingest": "python scripts/mlb_props_ingest.py",
    "polling:start": "python scripts/polling_loop.py",
    "db:backfill:sgo": "tsx scripts/sgo-backfill.ts --days=7 --sports=all",
    "db:backfill:sgo:test": "tsx scripts/sgo-backfill.ts --days=2 --sports=MLB,NBA --dry-run",
    "db:backfill:sgo:continuous": "tsx scripts/sgo-backfill.ts --continuous --days=30",
    "db:backfill:sgo:sport": "tsx scripts/sgo-backfill.ts --sport=$SPORT --days=7",
    "sgo:backfill": "tsx scripts/sgo-backfill.ts",
    "sgo:settlement": "tsx scripts/sgo-settlement.ts",
    "sgo:health": "tsx scripts/sgo-health-check.ts",
    "test:real-world-e2e": "tsx scripts/test-real-world-e2e.ts",
    "test:production-pipeline": "tsx scripts/test-real-world-e2e.ts --duration=60min --validate-settlement",
    "history:import": "tsx scripts/historical-data-import.ts",
    "history:import-all": "tsx scripts/historical-data-import.ts --years=2 --sports=all --validate-cappers",
    "history:dvp-analysis": "tsx scripts/historical-data-import.ts --sports=NFL --no-h2h",
    "scoring:analyze-vs-cappers": "tsx scripts/scoring-algorithm-analysis.ts",
    "scoring:backtest": "tsx scripts/scoring-algorithm-analysis.ts --period=1year --vs-human-cappers",
    "scoring:performance-report": "tsx scripts/scoring-algorithm-analysis.ts --export-detailed",
    "scoring:test-enhanced": "tsx scripts/test-enhanced-scoring.ts",
    "scoring:test-professional": "tsx scripts/test-enhanced-scoring.ts --verbose",
    "test:golden": "tsx scripts/run-golden-tests.ts",
    "test:golden-watch": "tsx scripts/run-golden-tests.ts --watch",
    "test:golden-devigging": "jest test/professional/devigging.golden.test.ts --verbose",
    "test:golden-clv": "jest test/professional/clv-tracking.golden.test.ts --verbose",
    "test:golden-scoring": "jest test/professional/enhanced-scoring.golden.test.ts --verbose",
    "test:golden-tiers": "jest test/professional/tier-assignment.golden.test.ts --verbose",
    "test:golden-logging": "jest test/professional/debug-logging.golden.test.ts --verbose",
    "test:golden-integration": "jest test/professional/integration.golden.test.ts --verbose",
    "test:shadow": "jest --config jest.shadow.config.js",
    "test:shadow-watch": "jest --config jest.shadow.config.js --watch",
    "test:shadow-coverage": "jest --config jest.shadow.config.js --coverage",
    "test:shadow-e2e": "tsx scripts/test-shadow-mode.ts",
    "scoring:espn-test": "tsx scripts/test-espn-scoring.ts",
    "scoring:espn-estimate": "tsx scripts/test-espn-scoring.ts --estimate",
    "scoring:espn-historical": "tsx scripts/score-historical-props-espn.ts",
    "scoring:espn-test-run": "tsx scripts/score-historical-props-espn.ts --test",
    "qa:e2e": "playwright test",
    "qa:health": "node test-health-endpoint.js",
    "qa:health-quick": "playwright test tests/api/health.spec.ts --project=chromium",
    "qa:accessibility": "tsx qa/tests/accessibility.test.ts",
    "qa:security": "tsx qa/tests/security.test.ts",
    "qa:mobile": "tsx qa/tests/mobile.test.ts",
    "qa:performance": "tsx qa/tests/performance.test.ts",
    "qa:full": "npm run qa:e2e && npm run qa:accessibility && npm run qa:security && npm run qa:mobile && npm run qa:performance && npm run qa:report",
    "db:migrate": "tsx scripts/run-migrations.ts",
    "db:migrate:critical": "tsx scripts/execute-database-migration.ts",
    "db:validate:schema": "tsx scripts/execute-database-migration.ts --validate-only",
    "db:inventory": "tsx ../../scripts/db/inventory-schema.ts",
    "db:archive": "tsx scripts/run-archive.ts",
    "syndicate:start": "tsx src/scripts/start-syndicate.ts",
    "syndicate:stop": "kill -TERM $(pgrep -f start-syndicate)",
    "syndicate:status": "node -e \"fetch('http://localhost:9091/health').then(r=>r.json()).then(j=>console.log(JSON.stringify(j,null,2))).catch(e=>console.error(e))\"",
    "workflows:start": "tsx src/scripts/start-workflows-now.ts",
    "workflows:start-critical": "tsx src/scripts/start-workflows-now.ts --critical-only",
    "workflows:dry-run": "tsx src/scripts/start-workflows-now.ts --dry-run",
    "workflows:status": "echo 'Access Temporal UI: http://localhost:8088'",
    "dev:services": "docker compose up -d postgres redis temporal temporal-web",
    "dev:stop": "docker compose down",
    "dev:logs": "docker compose logs -f",
    "dev:status": "docker compose ps",
    "runner:build": "tsc -p tsconfig.runner.json",
    "runner:start": "TS_NODE_COMPILER_OPTIONS=\"{\\\"noResolve\\\":false,\\\"types\\\":[\\\"node\\\"]}\" ts-node --project tsconfig.runner.json src/runner/runFeedAgentNow.ts",
    "test:ci": "node /app/node_modules/jest/bin/jest.js --config '{\"preset\":\"ts-jest\",\"testEnvironment\":\"node\",\"rootDir\":\"/app/apps/api\",\"transform\":{\"^.+\\\\.(t|j)sx?$\":\"ts-jest\"}}' test/contracts/database-schema.test.ts test/smartform/view-performance.test.ts --runInBand --silent",
    "agent:feed": "tsx src/runner/runFeedAgentNow.ts",
    "agent:score": "tsx src/runner/runScoringAgent.ts",
    "agent:alert": "tsx -e \"import('./src/agents/AlertAgent').then(m => m.processRecentPicks?.() || console.log('Alert agent run'))\"",
    "agent:settle": "tsx -e \"import('./src/agents/SettlementAgent').then(m => m.checkRecentSettlements?.() || console.log('Settlement check run'))\"",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.56.0",
    "@notionhq/client": "^2.2.15",
    "@opentelemetry/api": "^1.8.0",
    "@opentelemetry/auto-instrumentations-node": "^0.41.1",
    "@opentelemetry/exporter-jaeger": "^1.22.0",
    "@opentelemetry/exporter-prometheus": "^0.48.0",
    "@opentelemetry/sdk-node": "^0.49.1",
    "@opentelemetry/semantic-conventions": "^1.22.0",
    "@supabase/supabase-js": "^2.50.0",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-query-devtools": "^5.83.0",
    "@temporalio/activity": "^1.8.0",
    "@temporalio/client": "^1.8.0",
    "@temporalio/worker": "^1.8.0",
    "@temporalio/workflow": "^1.8.0",
    "@types/cors": "^2.8.19",
    "@types/express-rate-limit": "^5.1.3",
    "@unit-talk/database": "1.0.0",
    "axios": "^1.9.0",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "discord.js": "^14.14.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "gpt-tokenizer": "^3.0.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.6.1",
    "luxon": "^3.6.1",
    "next-themes": "^0.4.6",
    "node-cron": "^3.0.3",
    "openai": "^4.103.0",
    "ora": "^5.4.1",
    "pg": "^8.16.3",
    "pino": "^8.21.0",
    "pino-pretty": "^10.3.1",
    "prom-client": "^15.1.3",
    "react-virtualized": "^9.22.6",
    "recharts": "^3.1.0",
    "redis": "^4.7.0",
    "sharp": "^0.34.3",
    "twilio": "^4.23.0",
    "uuid": "^11.1.0",
    "web-vitals": "^5.0.3",
    "winston": "^3.17.0",
    "zod": "^3.25.56"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.8.5",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^4.17.23",
    "@types/glob": "^8.1.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.6.2",
    "@types/node": "^20.19.8",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "@types/uuid": "^10.0.0",
    "@types/winston": "^2.4.4",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "axe-core": "^4.8.3",
    "cross-env": "^7.0.3",
    "cypress": "^14.5.1",
    "dotenv": "^17.2.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "glob": "^11.0.3",
    "husky": "^9.1.6",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.0.4",
    "lighthouse": "^12.8.2",
    "lint-staged": "^15.2.10",
    "nodemailer": "^7.0.3",
    "pa11y": "^8.0.0",
    "playwright": "^1.54.2",
    "prettier": "^3.5.3",
    "puppeteer": "^24.19.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
