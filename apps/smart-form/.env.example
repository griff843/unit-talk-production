# Smart Form Environment Variables
# Copy this file to .env and fill in your values
#
# IMPORTANT: Never commit .env files with real credentials to git!
#
# For contract verification script:
#   npx tsx scripts/verify-data-contracts.ts
#
# Required for verification:
#   - NEXT_PUBLIC_SUPABASE_URL
#   - SUPABASE_SERVICE_ROLE_KEY (or NEXT_PUBLIC_SUPABASE_ANON_KEY)

# ============================================================================
# SUPABASE (Required)
# ============================================================================

# Your Supabase project URL
# Format: https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here

# Anon key (limited permissions, safe for client-side)
# Find it: Supabase Dashboard > Settings > API > anon key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Service role key (has full database access - NEVER expose to client)
# Required for contract verification and server-side operations
# Find it: Supabase Dashboard > Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ============================================================================
# EXTERNAL APIS (Server-only)
# ============================================================================

OPTIMAL_API_KEY=your_optimal_api_key_here

# ============================================================================
# BRIDGE CONFIGURATION (Server-only)
# ============================================================================

DISCORD_WEBHOOK_URL=your_discord_webhook_url_here

# ============================================================================
# PLAYWRIGHT E2E TESTS
# ============================================================================

# Base URL for E2E API tests (defaults to http://localhost:3021)
# SMARTFORM_URL=http://localhost:3021

# ============================================================================
# DEVELOPMENT/DEBUG
# ============================================================================

# Set to 1 to enable direct DB access in development (NOT for production)
NEXT_PUBLIC_DEV_DIRECT_DB=0

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Node environment: development, production, test
NODE_ENV=development
