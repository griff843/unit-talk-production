# Docker build context exclusions for smart-form
# Created to fix circular symlink issue: node_modules/unit-talk-smart-form

# Node modules - contains workspace symlinks that cause circular references
node_modules
**/node_modules

# Specific problematic symlink (redundant but explicit)
node_modules/unit-talk-smart-form

# Build artifacts
.next
out
dist
build

# Development files
.env.local
.env.development.local
.env.test.local
.env.production.local

# Test artifacts
coverage
.nyc_output

# IDE and editor files
.idea
.vscode
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Git
.git
.gitignore

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
