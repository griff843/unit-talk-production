# Unit Talk Platform - SaaS-Grade Makefile
# Enterprise DevOps Automation

.PHONY: help start stop restart status health monitor logs clean reset backup restore scale test deploy

# Default target
.DEFAULT_GOAL := help

# Variables
COMPOSE := docker-compose
COMPOSE_PROD := docker-compose -f docker-compose.yml -f docker-compose.prod.yml
TIMESTAMP := $(shell powershell Get-Date -Format yyyyMMdd_HHmmss)
BACKUP_DIR := ./backups/$(TIMESTAMP)

# Help target
help: ## Show this help message
	@echo Unit Talk Platform - SaaS-Grade DevOps Commands
	@echo ==================================================
	@echo.
	@echo Available commands:
	@echo   start           Start development environment
	@echo   start-prod      Start production environment
	@echo   stop            Stop all services
	@echo   restart         Restart all services
	@echo   status          Show service status
	@echo   health          Perform health checks
	@echo   monitor         Open monitoring dashboards
	@echo   logs            Show service logs
	@echo   scale           Scale a service
	@echo   backup          Create full backup
	@echo   clean           Clean up containers
	@echo   reset           Reset environment
	@echo.
	@echo Examples:
	@echo   make start
	@echo   make monitor
	@echo   make scale service=api replicas=3

# Development Commands
start: ## Start development environment
	@echo Starting Unit Talk development environment...
	@$(COMPOSE) up -d
	@echo Development environment started!
	@make status

start-prod: ## Start production environment with full monitoring
	@echo Starting Unit Talk production environment...
	@$(COMPOSE_PROD) up -d
	@echo Production environment started!
	@make health

stop: ## Stop all services
	@echo Stopping all services...
	@$(COMPOSE) down
	@echo All services stopped

restart: ## Restart all services
	@echo Restarting services...
	@$(COMPOSE) restart
	@echo Services restarted

# Monitoring Commands
status: ## Show service status
	@echo Service Status:
	@$(COMPOSE) ps

health: ## Perform health checks on all services
	@echo Performing health checks...
	@powershell ./scripts/health-check.ps1

monitor: ## Open monitoring dashboards
	@echo Opening monitoring dashboards...
	@start http://localhost:3004
	@start http://localhost:9090
	@start http://localhost:3000
	@start http://localhost:8088

logs: ## Show logs for all services
	@$(COMPOSE) logs -f --tail=50

# Build Commands
build: ## Build all services
	@echo Building all services...
	@$(COMPOSE) build --parallel
	@echo Build completed

build-prod: ## Build for production
	@echo Building for production...
	@$(COMPOSE_PROD) build --parallel
	@echo Production build completed

# Maintenance Commands
clean: ## Clean up containers and volumes
	@echo Cleaning up...
	@$(COMPOSE) down --remove-orphans
	@docker system prune -f
	@echo Cleanup completed

reset: ## Reset environment (removes all data)
	@echo WARNING: This will delete all data and volumes!
	@$(COMPOSE) down --volumes --remove-orphans
	@docker system prune -af
	@echo Environment reset completed

backup: ## Create full backup
	@echo Creating full backup...
	@powershell ./scripts/backup.ps1
	@echo Backup completed

# Testing Commands
test: ## Run all tests
	@echo Running tests...
	@$(COMPOSE) exec api npm run test
	@echo All tests passed

lint: ## Run linting
	@echo Running linters...
	@$(COMPOSE) exec api npm run lint
	@echo Linting completed

type-check: ## Run TypeScript type checking
	@echo Running type check...
	@$(COMPOSE) exec api npm run type-check
	@echo Type check completed
