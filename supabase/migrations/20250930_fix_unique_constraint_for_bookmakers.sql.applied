-- Fix unique constraint to allow multiple bookmakers per prop
-- CRITICAL: Required for devigging and professional betting features

-- Drop the old constraint that blocks multiple bookmakers
DROP INDEX IF EXISTS public.idx_unified_picks_external_ids;

-- Add metadata column if it doesn't exist (stores bookmaker info)
ALTER TABLE public.unified_picks
  ADD COLUMN IF NOT EXISTS metadata jsonb DEFAULT '{}'::jsonb;

-- Create new unique constraint that includes bookmaker_key from metadata
-- This allows DraftKings, FanDuel, BetMGM, Caesars odds for the same prop
CREATE UNIQUE INDEX idx_unified_picks_unique_per_bookmaker
  ON public.unified_picks (
    external_game_id,
    external_prop_id,
    market,
    COALESCE((metadata->>'bookmaker_key')::text, 'unknown')
  );

-- Create supporting indexes for fast queries
CREATE INDEX IF NOT EXISTS idx_unified_picks_game_market
  ON public.unified_picks (external_game_id, market);

CREATE INDEX IF NOT EXISTS idx_unified_picks_bookmaker
  ON public.unified_picks ((metadata->>'bookmaker_key'));

-- Comment explaining why this is critical
COMMENT ON INDEX idx_unified_picks_unique_per_bookmaker IS
  'Allows multiple bookmakers per prop - REQUIRED for devigging, line shopping, and professional betting features. Each bookmaker can have different odds for the same prop.';

