€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚ÂÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚ÂÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚ÂÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚ÂÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚ÂÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚ÂÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚ÂÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚ÂÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬';

  -- ==================================================================================
  -- STEP 3: Batch insert loop
  -- ==================================================================================
  WHILE v_offset < v_total LOOP
    v_batch_start := clock_timestamp();

    -- Insert batch with data extraction and transformation
    INSERT INTO raw_props (
      id,
      sport,
      market,
      player_name,
      selection,
      line,
      odds,
      bookmaker_key,
      game_id,
      game_date,
      external_prop_id,
      external_game_id,
      matchup,
      source,
      metadata,
      created_at,
      updated_at,
      user_id
    )
    SELECT
      -- Use existing raw_id or generate new UUID
      COALESCE(upl.raw_id, gen_random_uuid()) as id,

      -- Sport (required)
      COALESCE(upl.sport, 'unknown') as sport,

      -- Market type (extract from metadata or use pick_type)
      COALESCE(
        upl.market,
        upl.metadata->>'market',
        upl.pick_type,
        'unknown'
      ) as market,

      -- Player name (extract from metadata, selection, or default)
      COALESCE(
        upl.metadata->>'player_name',
        upl.metadata->>'player',
        -- Try to extract from selection (e.g., "Patrick Mahomes Over 250.5")
        CASE
          WHEN upl.selection ~ '^[A-Za-z\. ]+ (Over|Under)'
          THEN REGEXP_REPLACE(upl.selection, ' (Over|Under).*$', '')
          ELSE 'Unknown Player'
        END
      ) as player_name,

      -- Selection (Over/Under/Team/etc)
      COALESCE(upl.selection, 'Unknown') as selection,

      -- Line value
      upl.line,

      -- Odds (American format)
      COALESCE(upl.odds, -110) as odds,

      -- Bookmaker key
      COALESCE(upl.bookmaker_key, 'unknown') as bookmaker_key,

      -- Game ID (prefer external_game_id, fallback to game_id)
      COALESCE(
        upl.external_game_id,
        upl.game_id,
        upl.metadata->>'game_id'
      ) as game_id,

      -- Game date (required)
      COALESCE(
        upl.game_date,
        upl.game_start_time,
        upl.created_at
      ) as game_date,

      -- External prop ID
      upl.external_prop_id,

      -- External game ID
      COALESCE(upl.external_game_id, upl.game_id) as external_game_id,

      -- Matchup description
      COALESCE(upl.matchup, upl.metadata->>'matchup', 'Unknown Matchup') as matchup,

      -- Source (mark as legacy backfill)
      COALESCE(upl.source, 'legacy_backfill') as source,

      -- Preserve original metadata with backfill flag
      COALESCE(upl.metadata, '{}'::JSONB) ||
        jsonb_build_object(
          'backfilled_from', 'unified_picks_legacy',
          'backfilled_at', NOW(),
          'legacy_id', upl.id
        ) as metadata,

      -- Timestamps
      upl.created_at,
      COALESCE(upl.updated_at, upl.created_at) as updated_at,

      -- User ID (owner of this prop)
      upl.user_id

    FROM unified_picks_legacy upl
    WHERE NOT EXISTS (
      SELECT 1 FROM raw_props rp
      WHERE rp.id = upl.raw_id
         OR (upl.external_prop_id IS NOT NULL AND rp.external_prop_id = upl.external_prop_id)
    )
    ORDER BY upl.created_at  -- Chronological order
    LIMIT v_batch_size
    OFFSET v_offset
    ON CONFLICT (id) DO NOTHING;  -- Skip duplicates silently

    -- Get number of rows inserted in this batch
    GET DIAGNOSTICS v_batch_inserted = ROW_COUNT;
    v_inserted := v_inserted + v_batch_inserted;
    v_offset := v_offset + v_batch_size;

    -- Calculate batch duration
    v_batch_duration := clock_timestamp() - v_batch_start;

    -- Progress logging
    RAISE NOTICE '  Batch %/% | Inserted: % | Total: % | Duration: % ms',
      CEIL(v_offset::NUMERIC / v_batch_size),
      CEIL(v_total::NUMERIC / v_batch_size),
      v_batch_inserted,
      v_inserted,
      EXTRACT(MILLISECONDS FROM v_batch_duration)::INT;

    -- Checkpoint commit every 10 batches (10,000 rows)
    IF v_offset % 10000 = 0 THEN
      RAISE NOTICE '  ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â¦ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã¢â‚¬Å“ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Â¦ÃƒÂ¢Ã¢â€šÂ¬Ã…â€œ Checkpoint: % rows migrated', v_inserted;
      COMMIT;
    END IF;
  END LOOP;

