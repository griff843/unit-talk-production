-- =====================================================================================
-- Migration: 50_backfill_raw_props.sql
-- Purpose: Idempotent backfill script to migrate data from unified_picks_legacy
-- Strategy: Batch insert with conflict handling, progress logging, and validation
-- Dependencies: 40_unified_picks_view.sql (creates unified_picks_legacy table)
-- =====================================================================================

-- =====================================================================================
-- PRE-FLIGHT CHECKS
-- =====================================================================================
DO $$
DECLARE
  v_legacy_exists BOOLEAN;
  v_legacy_count BIGINT;
BEGIN
  -- Check if legacy table exists
  SELECT EXISTS (
    SELECT 1 FROM pg_tables
    WHERE schemaname = 'public' AND tablename = 'unified_picks_legacy'
  ) INTO v_legacy_exists;

  IF NOT v_legacy_exists THEN
    RAISE NOTICE 'ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Â¦Ãƒâ€šÃ‚Â¾ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¹ No unified_picks_legacy table found - skipping backfill';
    RAISE NOTICE '  This is normal if this is a fresh installation';
    RETURN;
  END IF;

  -- Count legacy records
  SELECT COUNT(*) INTO v_legacy_count FROM unified_picks_legacy;
  RAISE NOTICE 'ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â¦ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã¢â‚¬Å“ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Â¦ÃƒÂ¢Ã¢â€šÂ¬Ã…â€œ Found unified_picks_legacy with % rows', v_legacy_count;

  IF v_legacy_count = 0 THEN
    RAISE NOTICE 'ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Â¦Ãƒâ€šÃ‚Â¾ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¹ unified_picks_legacy is empty - skipping backfill';
    RETURN;
  END IF;
END $$;

-- =====================================================================================
-- BACKFILL: unified_picks_legacy ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¾Ãƒâ€šÃ‚Â¢ raw_props
-- =====================================================================================
-- Migrates prop data from legacy unified_picks to new raw_props table
-- Handles missing columns, extracts data from JSONB metadata, and skips duplicates
-- =====================================================================================

DO $$
DECLARE
  v_batch_size INT := 1000;              -- Batch size for bulk insert
  v_offset INT := 0;                     -- Current offset in pagination
  v_total INT;                           -- Total records to migrate
  v_inserted INT := 0;                   -- Total records inserted
  v_batch_inserted INT;                  -- Records inserted in current batch
  v_start_time TIMESTAMP := NOW();       -- Migration start time
  v_batch_start TIMESTAMP;               -- Batch start time
  v_batch_duration INTERVAL;             -- Batch duration
  v_legacy_exists BOOLEAN;               -- Flag: does legacy table exist
BEGIN
  -- ==================================================================================
  -- STEP 1: Verify legacy table exists
  -- ==================================================================================
  SELECT EXISTS (
    SELECT 1 FROM pg_tables
    WHERE schemaname = 'public' AND tablename = 'unified_picks_legacy'
  ) INTO v_legacy_exists;

  IF NOT v_legacy_exists THEN
    RAISE NOTICE 'ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â¦ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â¹ÃƒÆ’Ã¢â‚¬Â¦ÃƒÂ¢Ã¢â€šÂ¬Ã…â€œ No unified_picks_legacy table found - exiting';
    RETURN;
  END IF;

  -- ==================================================================================
  -- STEP 2: Count records to migrate (not already in raw_props)
  -- ==================================================================================
  SELECT COUNT(*) INTO v_total
  FROM unified_picks_legacy upl
  WHERE NOT EXISTS (
    SELECT 1 FROM raw_props rp
    WHERE rp.id = upl.raw_id
       OR (upl.external_prop_id IS NOT NULL AND rp.external_prop_id = upl.external_prop_id)
  );

  IF v_total = 0 THEN
    RAISE NOTICE 'ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â¦ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã¢â‚¬Å“ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Â¦ÃƒÂ¢Ã¢â€šÂ¬Ã…â€œ All legacy records already in raw_props - skipping backfill';
    RETURN;
  END IF;

