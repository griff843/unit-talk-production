# =============================================================================
# UNIT TALK E2E SMOKE TEST - REQUIRED ENVIRONMENT VARIABLES
# =============================================================================
# SPRINT-RUNTIME-TRUTH-008: Deterministic smoke env profile
#
# Copy this file to .env.smoke and fill in the actual values.
# DO NOT commit .env.smoke - it is gitignored.
#
# To generate .env.smoke from existing sources:
#   node scripts/generate-smoke-env.mjs
# =============================================================================

# =============================================================================
# REQUIRED VARIABLES (fail-closed if missing)
# =============================================================================

# Supabase Connection (REQUIRED)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key...

# =============================================================================
# OPTIONAL VARIABLES (defaults available)
# =============================================================================

# If smoke test needs to hit Discord (usually dry-run)
# DISCORD_WEBHOOK_URL_SMOKE=https://discord.com/api/webhooks/...

# =============================================================================
# NOTES
# =============================================================================
# - The smoke test uses SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY
# - SUPABASE_ANON_KEY is NOT required for smoke tests (service role bypasses RLS)
# - Discord posting is dry-run by default in smoke tests
