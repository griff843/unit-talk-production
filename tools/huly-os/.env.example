# GitHub (required for all modes — read access)
GITHUB_TOKEN=ghp_your_token_here
GITHUB_OWNER=your-org
GITHUB_REPO=unit-talk-production

# GitHub Issues Auth (write access for task generation)
# Priority: App → Classic PAT → GH_TOKEN (local only)
#
# Option 1: GitHub App (preferred for CI)
# GITHUB_APP_ID=123456
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# GITHUB_APP_INSTALLATION_ID=78901234
#
# Option 2: Classic PAT (must have repo + issues scope)
# GITHUB_TOKEN_CLASSIC=ghp_classicPatHere
#
# Option 3: GH_TOKEN (local dev only — rejected in CI)
# Set automatically by `gh auth login`. NOT valid for CI.

# Huly (required for --run and --smoke; optional for --dry-run)
HULY_URL=http://localhost:8087
HULY_EMAIL=user1@example.com
HULY_PASSWORD=1234
HULY_WORKSPACE=ws1
HULY_PROJECT=UT
HULY_TEAMSPACE=Operations

# Publish fallback: issue ID for comment-based fallback (optional)
# HULY_REPORT_FALLBACK_ISSUE_ID=HULY-123

# LLM Provider (optional — omit for deterministic summarizer)
# If set, LLM is attempted first; deterministic is the fallback on failure.
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...
#
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_API_KEY=sk-ant-...

# Auto PR Generation (opt-in — disabled by default)
# When enabled, the daemon generates patches from TaskCandidates and opens PRs.
# Requires LLM_PROVIDER to be set (patches are LLM-generated).
# AUTO_PR_ENABLED=false
# AUTO_PR_MAX_TASKS=2
# AUTO_PR_BRANCH_PREFIX=sprint/huly-auto-pr-
# AUTO_PR_LABEL=autopr
# AUTO_PR_BASE=main
# AUTO_PR_ALLOWED_PATHS=tools/huly-os/,docs/huly-os/
# AUTO_PR_REQUIRE_GREEN_LOCAL=true

# Event Bus — Redis Streams (opt-in — disabled by default)
# When enabled, the daemon consumes events from a Redis Stream and triggers
# report cycles. Requires EVENTBUS_REDIS_URL.
# EVENTBUS_ENABLED=false
# EVENTBUS_REDIS_URL=redis://localhost:6379
# EVENTBUS_STREAM=ut:events
# EVENTBUS_GROUP=huly-os
# EVENTBUS_CONSUMER=                   # defaults to hostname-pid
# EVENTBUS_BLOCK_MS=5000
# EVENTBUS_DEDUPE_TTL_SECONDS=300
# EVENTBUS_ALLOW_LIVE=false            # must be true to allow live publish from events
# EVENTBUS_MAX_BATCH=10
# EVENTBUS_CI_ALLOW=false              # must be true to run consumer in CI

# Operator Scheduler (opt-in — disabled by default)
# When enabled, the daemon runs report cycles on a timer.
# Normal cycles run --dry-run; deep cycles run --run at OPERATOR_DEEP_RUN_HOUR.
# OPERATOR_ENABLED=false
# OPERATOR_INTERVAL_MINUTES=60
# OPERATOR_DEEP_RUN_HOUR=3
# OPERATOR_MAX_CONCURRENT=1

# Output (defaults to out/ops/reality)
OUTPUT_DIR=out/ops/reality
