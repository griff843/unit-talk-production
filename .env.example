# Unit Talk Platform - Development Environment Variables
# Copy this file to .env and fill in your actual values

# =============================================================================
# CORE APPLICATION SETTINGS
# =============================================================================
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Local PostgreSQL (if not using Supabase)
# SECURITY: Generate strong passwords for production
POSTGRES_PASSWORD=your-secure-postgres-password
POSTGRES_DB=unit_talk_dev
POSTGRES_USER=postgres

# PostgreSQL Replica Configuration
POSTGRES_REPLICA_USER=replicator
POSTGRES_REPLICA_PASSWORD=your-secure-replica-password

# Temporal Database Configuration
TEMPORAL_POSTGRES_PASSWORD=your-secure-temporal-password
TEMPORAL_POSTGRES_USER=temporal
TEMPORAL_POSTGRES_DB=temporal

# =============================================================================
# TEMPORAL WORKFLOW ENGINE
# =============================================================================
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=unit-talk-dev

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_URL=redis://localhost:6379

# =============================================================================
# SECURITY & ENCRYPTION
# =============================================================================
JWT_SECRET=your-jwt-secret-key-min-32-chars
ENCRYPTION_KEY=your-encryption-key-exactly-32-chars

# =============================================================================
# DISCORD INTEGRATION
# =============================================================================
DISCORD_TOKEN=your-discord-bot-token
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-url
DISCORD_OPERATOR_WEBHOOK_URL=https://discord.com/api/webhooks/your-operator-webhook-url

# =============================================================================
# PROFESSIONAL SCORING SYSTEM
# =============================================================================
# Enable professional grading pipeline (default: false for safety)
USE_PRO_SCORER=false

# Enable detailed scoring debug logs (default: false to control costs)
SCORING_DEBUG=false

# =============================================================================
# AI MODEL ROUTING & COST CONTROL
# =============================================================================
# AI model routing for cost optimization
ADVICE_MODEL_DEFAULT=kimi-k2
ADVICE_MODEL_FALLBACK=claude-sonnet
ADVICE_MODEL_MVP=gpt-4-turbo

# AI caching and re-query thresholds
ADVICE_CACHE_TTL_SEC=86400
ADVICE_REQUERY_BPS=15

# =============================================================================
# PROMOTION GATES & PORTFOLIO RISK MANAGEMENT
# =============================================================================
# Promotion gate thresholds
INSTANT_S_TIER_MIN_EV=0.05
INSTANT_S_TIER_MIN_CONFIDENCE=0.75
INSTANT_S_TIER_MIN_PROFESSIONAL_SCORE=85
SCHEDULED_10AM_MIN_EV=0.03
SCHEDULED_10AM_MIN_CONFIDENCE=0.65

# S-tier enforcement thresholds
S_TIER_MIN_CLV_BPS=15
S_TIER_MAX_NEGATIVE_CLV_BPS=-3
S_TIER_MIN_STEAM_STRENGTH=20
S_TIER_REQUIRE_POSITIVE_STEAM=true

# Portfolio risk limits
MAX_SINGLE_POSITION_SIZE=0.25
MAX_DAILY_PORTFOLIO_RISK=1.0
MAX_GAME_EXPOSURE=0.40
MAX_PLAYER_EXPOSURE=0.30
MAX_CORRELATION_THRESHOLD=0.70
MAX_CORRELATED_POSITIONS=3

# Portfolio concentration limits
MAX_SPORT_CONCENTRATION=0.60
MAX_TIER_CONCENTRATION=0.80
DAILY_VAR_LIMIT=0.15
WEEKLY_DRAWDOWN_LIMIT=0.25

# Optional custom weights configuration file path
# SCORING_WEIGHTS_PATH=/path/to/custom/weights.json

# =============================================================================
# EXTERNAL API KEYS
# =============================================================================
# Optimal API Configuration (Secondary for player props)
OPTIMAL_API_KEY=your-optimal-api-key

# The Odds API Configuration (Primary for comprehensive coverage)
ODDS_API_KEY=8014c48eb8a05f289de049c0961ac4cf

# SGO API Configuration (optional for development)
SGO_API_KEY=dummy_key_for_dev

# OpenAI API Configuration (for AI advice and formatting)
OPENAI_API_KEY=your-openai-api-key

# =============================================================================
# MONITORING & OBSERVABILITY
# =============================================================================
# Grafana Admin Password
GRAFANA_PASSWORD=admin

# =============================================================================
# DEVELOPMENT SPECIFIC
# =============================================================================
# Enable development features
DEBUG_MODE=true
HOT_RELOAD=true

# API Rate Limiting (disabled for dev)
RATE_LIMIT_ENABLED=false

# Security Headers (relaxed for dev)
SECURITY_HEADERS_ENABLED=false

# =============================================================================
# SHADOW MODE CONFIGURATION
# =============================================================================
# Shadow mode enables full grading/promotion flow without public posting
SHADOW_MODE=false                            # true = no public posting, shadow only
SHADOW_PRIVATE_CHANNEL_ID=                   # Optional: Discord channel for shadow previews
SHADOW_MAX_DAYS=7                            # Auto-cleanup for old shadow rows (days)

# =============================================================================
# OPTIONAL CONFIGURATIONS
# =============================================================================
# Email Configuration (if needed)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# Webhook URLs for testing
# TEST_WEBHOOK_URL=https://webhook.site/your-unique-url

# =============================================================================
# NOTES
# =============================================================================
# 1. Never commit this file with real values to version control
# 2. Use strong, unique passwords and keys for all environments
# 3. Rotate secrets regularly in production
# 4. Consider using a secrets management service for production
# 5. Ensure all webhook URLs are properly configured and accessible