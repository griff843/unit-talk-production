# Unit Talk Platform - Development Environment Variables
# Copy this file to .env and fill in your actual values

# =============================================================================
# CORE APPLICATION SETTINGS
# =============================================================================
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# API Readiness Configuration
API_READINESS_URL=http://localhost:3000/health/ready  # <fill-me e.g., https://api.example.com/health/ready>

# Tenant / Tagging
ORG_ID=dev                            # <fill-me e.g., prod>
CANARY_TAG=local-dev                  # <fill-me e.g., claude-ci>

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Local PostgreSQL (if not using Supabase)
# SECURITY: Generate strong passwords for production
POSTGRES_PASSWORD=your-secure-postgres-password
POSTGRES_DB=unit_talk_dev
POSTGRES_USER=postgres

# PostgreSQL Replica Configuration
POSTGRES_REPLICA_USER=replicator
POSTGRES_REPLICA_PASSWORD=your-secure-replica-password

# Temporal Database Configuration
TEMPORAL_POSTGRES_PASSWORD=your-secure-temporal-password
TEMPORAL_POSTGRES_USER=temporal
TEMPORAL_POSTGRES_DB=temporal

# =============================================================================
# TEMPORAL WORKFLOW ENGINE
# =============================================================================
TEMPORAL_ADDRESS=localhost:7233        # <fill-me e.g., temporal.prod.local:7233>
TEMPORAL_NAMESPACE=default             # <fill-me e.g., unit-talk-prod>
TEMPORAL_TASK_QUEUE=unit-talk-dev
# TEMPORAL_HEALTH_URL=                 # Optional if your scripts expect an HTTP probe instead

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_URL=redis://localhost:6379

# =============================================================================
# SECURITY & ENCRYPTION
# =============================================================================
JWT_SECRET=your-jwt-secret-key-min-32-chars
ENCRYPTION_KEY=your-encryption-key-exactly-32-chars

# =============================================================================
# DISCORD INTEGRATION
# =============================================================================
DISCORD_TOKEN=your-discord-bot-token
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-url
DISCORD_OPERATOR_WEBHOOK_URL=https://discord.com/api/webhooks/your-operator-webhook-url

# Canary Channel Configuration
CANARY_CHANNEL_ID=                    # <numeric-id e.g., 1296531122234327100>

# =============================================================================
# PROFESSIONAL SCORING SYSTEM
# =============================================================================
# Enable professional grading pipeline (default: false for safety)
USE_PRO_SCORER=false

# Enable detailed scoring debug logs (default: false to control costs)
SCORING_DEBUG=false

# =============================================================================
# AI MODEL ROUTING & COST CONTROL
# =============================================================================
# AI model routing for cost optimization
ADVICE_MODEL_DEFAULT=kimi-k2
ADVICE_MODEL_FALLBACK=claude-sonnet
ADVICE_MODEL_MVP=gpt-4-turbo

# AI caching and re-query thresholds
ADVICE_CACHE_TTL_SEC=86400
ADVICE_REQUERY_BPS=15

# =============================================================================
# PROMOTION GATES & PORTFOLIO RISK MANAGEMENT
# =============================================================================
# Promotion gate thresholds
INSTANT_S_TIER_MIN_EV=0.05
INSTANT_S_TIER_MIN_CONFIDENCE=0.75
INSTANT_S_TIER_MIN_PROFESSIONAL_SCORE=85
SCHEDULED_10AM_MIN_EV=0.03
SCHEDULED_10AM_MIN_CONFIDENCE=0.65

# S-tier enforcement thresholds
S_TIER_MIN_CLV_BPS=15
S_TIER_MAX_NEGATIVE_CLV_BPS=-3
S_TIER_MIN_STEAM_STRENGTH=20
S_TIER_REQUIRE_POSITIVE_STEAM=true

# Portfolio risk limits
MAX_SINGLE_POSITION_SIZE=0.25
MAX_DAILY_PORTFOLIO_RISK=1.0
MAX_GAME_EXPOSURE=0.40
MAX_PLAYER_EXPOSURE=0.30
MAX_CORRELATION_THRESHOLD=0.70
MAX_CORRELATED_POSITIONS=3

# Portfolio concentration limits
MAX_SPORT_CONCENTRATION=0.60
MAX_TIER_CONCENTRATION=0.80
DAILY_VAR_LIMIT=0.15
WEEKLY_DRAWDOWN_LIMIT=0.25

# Optional custom weights configuration file path
# SCORING_WEIGHTS_PATH=/path/to/custom/weights.json

# =============================================================================
# EXTERNAL API KEYS
# =============================================================================
# Optimal API Configuration (Secondary for player props)
OPTIMAL_API_KEY=your-optimal-api-key

# The Odds API Configuration (Primary for comprehensive coverage)
ODDS_API_KEY=your-odds-api-key

# SGO API Configuration (optional for development)
SGO_API_KEY=dummy_key_for_dev

# OpenAI API Configuration (for AI advice and formatting)
OPENAI_API_KEY=your-openai-api-key

# =============================================================================
# FEED AGENT CONFIGURATION
# =============================================================================
# Provider configuration - which data sources to use (CSV list)
FEED_PROVIDERS=odds-api                     # Options: odds-api, sgo-api, optimal-api
FEED_DISABLE_SGO=1                          # Set to 1 to explicitly disable SGO API calls (no 403s)

# Market configuration - which betting markets to fetch (CSV list)
# Core markets: h2h, spreads, totals (fetched by default)
# Player props: Set FEED_ENABLE_PROPS=1 and configure per-sport markets below
FEED_MARKETS=h2h,spreads,totals             # Default: core markets only

# Bookmaker regions to fetch odds from (CSV list)
FEED_REGIONS=us                             # Options: us, uk, eu, au

# Bookmaker sportsbooks to include (CSV list) - filters specific books
# Reduces API credit usage by requesting only specified bookmakers
FEED_BOOKMAKERS=draftkings,caesars,fanduel,betmgm  # Top US books

# Event batching configuration - controls API request efficiency
# Batch event IDs per request to maximize credit efficiency (max 20 recommended)
FEED_EVENT_BATCH_SIZE=20                    # Number of event IDs per API request (default: 20)

# Event lookahead window - how far ahead to fetch event schedules
FEED_EVENT_LOOKAHEAD_HOURS=48               # Hours to look ahead for events (default: 48)

# =============================================================================
# ODDS API CONFIGURATION
# =============================================================================
# Odds API format preferences
ODDS_API_ODDS_FORMAT=american               # Options: american, decimal (default: american)
ODDS_API_DATE_FORMAT=iso                    # Options: iso, unix (default: iso)

# Credit management - quota guards to prevent overuse
# Minimum remaining credits before skipping props (optional requests)
ODDS_API_MIN_REMAINING=25                   # Skip props if remaining < threshold (default: 25)

# =============================================================================
# PLAYER PROPS CONFIGURATION (Feature-Flagged)
# =============================================================================
# Enable player props fetching (disabled by default for credit efficiency)
FEED_ENABLE_PROPS=0                         # Set to 1 to enable props (default: 0 = disabled)

# Sport-specific prop markets configuration
# Only used when FEED_ENABLE_PROPS=1 and sport is active
FEED_PROP_SPORTS=nfl                        # CSV list of sports to fetch props for
FEED_PROP_MARKETS_NFL=player_pass_yds,player_rush_yds,player_rec_yds
FEED_PROP_MARKETS_NBA=player_points,player_rebounds,player_assists
FEED_PROP_MARKETS_MLB=player_hits,player_home_runs,player_strikeouts
FEED_PROP_MARKETS_NHL=player_points,player_goals,player_assists

# Bookmakers for props (may differ from core markets)
FEED_PROP_BOOKMAKERS=draftkings,fanduel     # Focused prop books

# =============================================================================
# SMOKE TEST CONFIGURATION
# =============================================================================
# Smoke test database target (cloud or local)
SMOKE_DB_TARGET=cloud                       # Options: cloud (Supabase), local (Docker Postgres)
SMOKE_MODE=canary                           # Options: shadow (no writes), canary (writes enabled)
SMOKE_SPORT=nfl                             # Sport to test
SMOKE_SINCE_MIN=180                         # Minutes to look back for validation

# =============================================================================
# MONITORING & OBSERVABILITY
# =============================================================================
# Grafana Admin Password
GRAFANA_PASSWORD=admin

# =============================================================================
# DEVELOPMENT SPECIFIC
# =============================================================================
# Enable development features
DEBUG_MODE=true
HOT_RELOAD=true

# API Rate Limiting (disabled for dev)
RATE_LIMIT_ENABLED=false

# Security Headers (relaxed for dev)
SECURITY_HEADERS_ENABLED=false

# =============================================================================
# SHADOW MODE CONFIGURATION
# =============================================================================
# Shadow mode enables full grading/promotion flow without public posting
SHADOW_MODE=false                            # true = no public posting, shadow only
SHADOW_PRIVATE_CHANNEL_ID=                   # Optional: Discord channel for shadow previews
SHADOW_MAX_DAYS=7                            # Auto-cleanup for old shadow rows (days)

# =============================================================================
# OPTIONAL CONFIGURATIONS
# =============================================================================
# Email Configuration (if needed)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# Webhook URLs for testing
# TEST_WEBHOOK_URL=https://webhook.site/your-unique-url

# =============================================================================
# NOTES
# =============================================================================
# 1. Never commit this file with real values to version control
# 2. Use strong, unique passwords and keys for all environments
# 3. Rotate secrets regularly in production
# 4. Consider using a secrets management service for production
# 5. Ensure all webhook URLs are properly configured and accessible