# Unit Talk Platform - Test Environment Variables
# Environment configuration for automated testing and CI/CD

# =============================================================================
# CORE APPLICATION SETTINGS
# =============================================================================
NODE_ENV=test
PORT=3000
LOG_LEVEL=info
E2E_TEST_MODE=true

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Test Supabase Configuration
SUPABASE_URL_TEST=https://your-test-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY_TEST=your-test-service-role-key

# Test PostgreSQL
POSTGRES_PASSWORD=test_password
POSTGRES_DB=unit_talk_test
POSTGRES_USER=postgres

# =============================================================================
# TEMPORAL WORKFLOW ENGINE
# =============================================================================
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=unit-talk-test
TEMPORAL_TASK_QUEUE=unit-talk-test

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_URL=redis://localhost:6379

# =============================================================================
# SECURITY & ENCRYPTION (Test Keys)
# =============================================================================
JWT_SECRET_TEST=test-jwt-secret-key-for-testing-only
ENCRYPTION_KEY_TEST=test-encryption-key-32-chars-long

# =============================================================================
# DISCORD INTEGRATION (Test Bot)
# =============================================================================
DISCORD_TOKEN_TEST=your-test-discord-bot-token
DISCORD_CLIENT_ID_TEST=your-test-discord-client-id
DISCORD_WEBHOOK_URL_TEST=https://discord.com/api/webhooks/test-webhook-url
DISCORD_OPERATOR_WEBHOOK_URL_TEST=https://discord.com/api/webhooks/test-operator-webhook-url

# =============================================================================
# EXTERNAL API KEYS (Test/Mock)
# =============================================================================
# Test API Keys (use sandbox/test keys)
OPTIMAL_API_KEY_TEST=test-optimal-api-key
SGO_API_KEY=test_dummy_key

# =============================================================================
# MONITORING & OBSERVABILITY
# =============================================================================
GRAFANA_PASSWORD=test_admin

# =============================================================================
# TEST SPECIFIC CONFIGURATIONS
# =============================================================================
# Test timeouts and intervals
TEST_TIMEOUT=30000
TEST_RETRY_COUNT=3
TEST_PARALLEL_WORKERS=2

# Mock external services
MOCK_EXTERNAL_APIS=true
MOCK_DISCORD_WEBHOOKS=true

# Test data configuration
GENERATE_TEST_DATA=true
CLEANUP_TEST_DATA=true

# =============================================================================
# CI/CD SPECIFIC
# =============================================================================
# CI environment detection
CI=true
GITHUB_ACTIONS=true

# Test reporting
JEST_JUNIT_OUTPUT_DIR=./test-results
COVERAGE_DIRECTORY=./coverage

# =============================================================================
# NOTES FOR TESTING
# =============================================================================
# 1. Use separate test databases and Discord bots
# 2. All API keys should be test/sandbox versions
# 3. Webhook URLs should point to test channels or mock services
# 4. Test data is automatically cleaned up after each run
# 5. Mock external services to avoid rate limits and costs