{
  "mcpServers": {
    "byterover-mcp": {
      "type": "http",
      "url": "https://mcp.byterover.dev/mcp?machineId=1f05f302-824e-61a0-9c44-f35a49009ccc"
    },
    "supabase": {
      "command": "cmd",
      "args": ["/c", "npx", "@supabase/mcp-server-supabase"],
      "env": {
        "SUPABASE_URL": "${SUPABASE_URL}",
        "SUPABASE_ANON_KEY": "${SUPABASE_ANON_KEY}"
      }
    },
    "playwright": {
      "command": "cmd",
      "args": ["/c", "npx", "@playwright/mcp", "--headless"]
    },
    "magic": {
      "command": "cmd",
      "args": ["/c", "npx", "@21st-dev/magic"]
    },
    "sequential-thinking": {
      "command": "cmd",
      "args": ["/c", "npx", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "notion": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "notion-mcp-server"],
      "env": {
        "NOTION_TOKEN": "${NOTION_TOKEN}"
      }
    },
    "filesystem": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@modelcontextprotocol/server-filesystem", "C:/dev"]
    },
    "git": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@modelcontextprotocol/server-git", "--repo", "C:/dev/unit-talk-production"]
    },
    "terminal": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@modelcontextprotocol/server-shell"]
    },
    "unit-talk-ops": {
      "command": "cmd",
      "args": ["/c", "node", "packages/mcp-ops/dist/server.js"],
      "env": {
        "API_BASE_URL": "${API_BASE_URL}",
        "SUPABASE_URL": "${SUPABASE_URL}",
        "SUPABASE_SERVICE_ROLE_KEY": "${SUPABASE_SERVICE_ROLE_KEY}",
        "OPERATOR_TOKEN": "${OPERATOR_TOKEN}"
      }
    },
    "unit-talk-state": {
      "command": "cmd",
      "args": ["/c", "node", "packages/mcp-state/dist/server.js"],
      "env": {
        "SUPABASE_URL": "${SUPABASE_URL}",
        "SUPABASE_SERVICE_ROLE_KEY": "${SUPABASE_SERVICE_ROLE_KEY}"
      }
    },
    "unit-talk-intelligence": {
      "command": "cmd",
      "args": ["/c", "node", "packages/mcp-intelligence/dist/server.js"],
      "env": {
        "API_BASE_URL": "${API_BASE_URL}",
        "SUPABASE_URL": "${SUPABASE_URL}",
        "SUPABASE_SERVICE_ROLE_KEY": "${SUPABASE_SERVICE_ROLE_KEY}"
      }
    },
    "unit-talk-decision": {
      "command": "cmd",
      "args": ["/c", "node", "packages/mcp-decision/dist/server.js"],
      "env": {
        "REPO_ROOT": "${REPO_ROOT}"
      }
    }
  }
}
