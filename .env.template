# =============================================================================
# UNIT TALK PRODUCTION V3.0.0 - ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# This is a template file showing all required environment variables.
# Copy this file to .env and fill in the actual values for your environment.
#
# CRITICAL: Never commit the actual .env file to version control.
# =============================================================================

# =============================================================================
# ENVIRONMENT & DEPLOYMENT
# =============================================================================
NODE_ENV=development  # development | staging | production | test
LOG_LEVEL=debug       # error | warn | info | debug
DEBUG_MODE=false      # true | false

# Application Ports (for development/staging)
API_PORT=3000
DISCORD_BOT_PORT=3001
DASHBOARD_PORT=3002
SMART_FORM_PORT=3003
COMMAND_CENTER_PORT=3004

# =============================================================================
# DATABASE CONFIGURATION (v3.0.0 UNIFIED SCHEMA)
# =============================================================================
# Supabase Production Database - Unit Talk v3.0.0 Unified Schema
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Next.js Public Variables (for browser access)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Local PostgreSQL (Development/Testing)
POSTGRES_DB=unit_talk_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

# Replica Database Configuration (High Availability)
POSTGRES_REPLICA_USER=replicator
POSTGRES_REPLICA_PASSWORD=your_replica_password_here

# =============================================================================
# DATA PROVIDER API KEYS (PRIORITIZED BY SYSTEM ARCHITECTURE)
# =============================================================================
# Optimal API - PRIMARY DATA SOURCE for major sports player props (NFL/NBA/MLB/NHL)
# This is the main production API - system will fail without this key
OPTIMAL_API_KEY=your_optimal_api_key_here

# Odds API - SECONDARY SOURCE for NCAAF, settlement data, and fallback
ODDS_API_KEY=your_odds_api_key_here

# Sports Game Odds (SGO) API - TERTIARY FALLBACK SOURCE (optional)
# Only used as last resort when both Optimal and Odds APIs are unavailable
SGO_API_KEY=your_sgo_api_key_here
SPORTSGAMEODDS_KEY=your_sgo_api_key_here

# =============================================================================
# DISCORD BOT CONFIGURATION
# =============================================================================
# Discord Authentication
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_GUILD_ID=your_discord_guild_id_here

# Discord Roles - Staff
ADMIN_ROLE_IDS=role_id_1,role_id_2
MODERATOR_ROLE_IDS=role_id_here
BOT_ROLE_IDS=role_id_here
STAFF_ROLE_IDS=role_id_here
OWNER_ROLE_IDS=role_id_here

# Discord Roles - Member Tiers
VIP_ROLE_IDS=role_id_here
VIP_PLUS_ROLE_IDS=role_id_here
CAPPER_ROLE_IDS=role_id_here
TRIAL_ROLE_IDS=role_id_here

# =============================================================================
# DISCORD CHANNEL CONFIGURATION
# =============================================================================
# Core Communication Channels
ANNOUNCEMENTS_CHANNEL_ID=channel_id_here
GENERAL_CHANNEL_ID=channel_id_here
WELCOME_CHANNEL_ID=channel_id_here

# Pick Channels
FREE_PICKS_CHANNEL_ID=channel_id_here
VIP_PICKS_CHANNEL_ID=channel_id_here
VIP_PLUS_PICKS_CHANNEL_ID=channel_id_here

# VIP Arena Channels (2x XP Multiplier)
VIP_GENERAL_CHANNEL_ID=channel_id_here
VIP_STRATEGY_ROOM_CHANNEL_ID=channel_id_here

# VIP+ Arena Channels (2.5x XP Multiplier)
VIP_PLUS_GENERAL_CHANNEL_ID=channel_id_here
VIP_PLUS_STRATEGY_ROOM_CHANNEL_ID=channel_id_here
VIP_PLUS_EXCLUSIVE_INSIGHTS_CHANNEL_ID=channel_id_here
VIP_PLUS_TRADER_INSIGHTS_CHANNEL_ID=channel_id_here

# Support and Community
SUPPORT_CHANNEL_ID=channel_id_here
THREADS_CHANNEL_ID=channel_id_here
SPORTS_TALK_CHANNEL_ID=channel_id_here

# Staff Channels
ADMIN_CHANNEL_ID=channel_id_here
BOT_LOGS_CHANNEL_ID=channel_id_here

# =============================================================================
# TEMPORAL WORKFLOW ENGINE
# =============================================================================
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_SERVER_URL=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=unit-talk-dev

# Temporal Database Configuration
TEMPORAL_POSTGRES_PASSWORD=temporal_password_here
TEMPORAL_POSTGRES_USER=temporal
TEMPORAL_POSTGRES_DB=temporal

# =============================================================================
# REDIS & CACHING
# =============================================================================
REDIS_URL=redis://localhost:6379
CACHE_ENABLED=true
CACHE_TTL_SNAPSHOTS=90

# =============================================================================
# SECURITY & ENCRYPTION
# =============================================================================
JWT_SECRET=your-jwt-secret-key-minimum-32-characters-required
ENCRYPTION_KEY=your-encryption-key-exactly-32-chars
NEXTAUTH_SECRET=your_nextauth_secret_key_here

# =============================================================================
# PLATFORM API URLS (Internal Service Communication)
# =============================================================================
# Command Center Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3004
NEXTAUTH_URL=http://localhost:3004

# Platform API Integration
NEXT_PUBLIC_PLATFORM_API_URL=http://localhost:3000
UNIT_TALK_PRODUCTION_URL=http://localhost:3000

# Analytics and Monitoring
NEXT_PUBLIC_ANALYTICS_API_URL=http://localhost:3005
AGENTS_BASE_URL=http://localhost:3000
AGENTS_API_KEY=your-agents-api-key-here

# API Keys and Authentication
SYNC_API_KEY=your-sync-api-key-here

# =============================================================================
# FEATURE FLAGS & SYSTEM CONFIGURATION
# =============================================================================
# Core Bot Features
AUTO_GRADING_ENABLED=true
DM_NOTIFICATIONS_ENABLED=true
ANALYTICS_ENABLED=true
THREAD_MANAGEMENT_ENABLED=true

# Capper Corner Features
CAPPER_TRACKING_ENABLED=true
FORUM_MANAGEMENT_ENABLED=true
CAPPER_THREAD_AUTO_CREATE=true
CAPPER_QA_THREADS_ENABLED=true
CAPPER_PERFORMANCE_TRACKING=true
CAPPER_DAILY_PICK_AGGREGATION=true

# Community Engagement System
XP_SYSTEM_ENABLED=true
LEADERBOARD_ENABLED=true
ENGAGEMENT_TRACKING_ENABLED=true
MILESTONE_CELEBRATIONS_ENABLED=true
STREAK_TRACKING_ENABLED=true
ACHIEVEMENT_SYSTEM_ENABLED=true

# VIP Conversion & Marketing
VIP_CONVERSION_TRACKING=true
TRIAL_USAGE_TRACKING=true
UPGRADE_FUNNEL_ANALYTICS=true
AUTO_VIP_PROMOTION_MESSAGES=false

# Welcome & Onboarding System
WELCOME_SYSTEM_ENABLED=true
NEW_MEMBER_GUIDE_ENABLED=true
AUTO_ROLE_SUGGESTIONS=true

# =============================================================================
# XP SYSTEM CONFIGURATION
# =============================================================================
# XP Multipliers by Server Tier
XP_MULTIPLIER_GENERAL=1.5
XP_MULTIPLIER_VIP=2.0
XP_MULTIPLIER_VIP_PLUS=2.5

# XP Tracking Channels by Tier (comma-separated channel IDs)
XP_GENERAL_CHANNELS=channel_id_1,channel_id_2
XP_VIP_CHANNELS=channel_id_1,channel_id_2,channel_id_3
XP_VIP_PLUS_CHANNELS=channel_id_1,channel_id_2,channel_id_3,channel_id_4

# =============================================================================
# PICK MANAGEMENT SYSTEM
# =============================================================================
# Pick Submission Limits
MAX_PICKS_PER_DAY=10
MAX_UNITS_PER_PICK=10
MIN_UNITS_PER_PICK=1

# Supported Sports Categories
PICK_CATEGORIES=NFL,NBA,MLB,NHL,Soccer,Tennis,UFC,Boxing,College Football,College Basketball

# Auto-grading Configuration
AUTO_GRADE_DELAY_HOURS=2
GRADE_CONFIRMATION_REQUIRED=true
MANUAL_GRADE_OVERRIDE=true

# =============================================================================
# AUTOMATION FEATURES
# =============================================================================
# Daily Operations
DAILY_RECAP_ENABLED=true
DAILY_LEADERBOARD_UPDATE=true
DAILY_CAPPER_RANKINGS=true
PICK_REMINDER_ENABLED=true

# Weekly Operations
WEEKLY_STATS_ENABLED=true
WEEKLY_CAPPER_PERFORMANCE=true
WEEKLY_ENGAGEMENT_REPORT=true

# Monthly Operations
MONTHLY_REPORTS_ENABLED=true
MONTHLY_MEMBER_SPOTLIGHTS=true
MONTHLY_ACHIEVEMENT_SUMMARY=true

# =============================================================================
# NOTIFICATION SYSTEM
# =============================================================================
# DM Notifications
DM_PICK_CONFIRMATIONS=true
DM_GRADE_NOTIFICATIONS=true
DM_MILESTONE_ALERTS=true
DM_ACHIEVEMENT_NOTIFICATIONS=true

# Channel Notifications
ANNOUNCE_NEW_MEMBERS=true
ANNOUNCE_ROLE_CHANGES=true
ANNOUNCE_ACHIEVEMENTS=true
ANNOUNCE_CAPPER_HIGHLIGHTS=true
ANNOUNCE_LEADERBOARD_CHANGES=true

# =============================================================================
# ANALYTICS & REPORTING
# =============================================================================
# Performance Tracking
TRACK_PICK_PERFORMANCE=true
TRACK_USER_ENGAGEMENT=true
TRACK_CAPPER_PERFORMANCE=true
TRACK_CHANNEL_ACTIVITY=true
TRACK_RETENTION_RATES=true

# Report Generation
DAILY_REPORTS_ENABLED=true
WEEKLY_REPORTS_ENABLED=true
MONTHLY_REPORTS_ENABLED=true
CAPPER_PERFORMANCE_REPORTS=true
ENGAGEMENT_ANALYTICS=true

# =============================================================================
# MODERATION & SECURITY
# =============================================================================
AUTO_MODERATION_ENABLED=true
SPAM_DETECTION_ENABLED=true
RAID_PROTECTION_ENABLED=true
CONTENT_FILTERING=false

# =============================================================================
# SYSTEM PERFORMANCE & LIMITS
# =============================================================================
# Performance Settings
RATE_LIMIT_ENABLED=true
AUTO_BACKUP_ENABLED=true
HOT_RELOAD=false
SECURITY_HEADERS_ENABLED=true

# Thread Management
THREAD_AUTO_ARCHIVE_MINUTES=1440
FORUM_AUTO_CLEANUP_DAYS=30
CAPPER_THREAD_AUTO_ARCHIVE_HOURS=168

# Database Settings
DATA_RETENTION_DAYS=365
BACKUP_FREQUENCY_HOURS=24

# System Limits
MAX_DMS_PER_HOUR=5
MAX_THREADS_PER_DAY=20

# =============================================================================
# PROFESSIONAL SCORING SYSTEM
# =============================================================================
# Enable professional grading pipeline
USE_PRO_SCORER=true

# Enable shadow mode - full grading without public posting 
SHADOW_MODE=true

# Guardrail: Prevent any Discord publishing during settlement
PUBLISH_TO_DISCORD=false

# Promotion mode - precision for careful launch
PROMOTION_MODE=precision

# Professional scoring debug logs (keep false to control costs)
SCORING_DEBUG=false

# =============================================================================
# MONITORING & OBSERVABILITY
# =============================================================================
# Metrics and Monitoring
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9464
HEALTH_CHECK_INTERVAL=30000

# Error Tracking and Logging
SENTRY_DSN=your_sentry_dsn_here
LOG_RETENTION_DAYS=30

# =============================================================================
# INTEGRATIONS
# =============================================================================
# Notion Integration
NOTION_TOKEN=your_notion_token_here

# Discord Webhooks
DISCORD_ALERT_WEBHOOK=https://discord.com/api/webhooks/your_webhook_here
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_here
ALERTS_CHANNEL_ID=your_alerts_channel_id_here

# Email Service (if applicable)
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
FROM_EMAIL=noreply@yourdomain.com

# =============================================================================
# CI/CD & DEPLOYMENT
# =============================================================================
# Build Configuration
BUILD_ENV=development
DOCKER_REGISTRY=your_registry_here
IMAGE_TAG=latest

# Deployment Configuration
DEPLOY_TARGET=development
CLUSTER_NAME=your_cluster_name
NAMESPACE=unit-talk

# =============================================================================
# DEVELOPMENT/TESTING OVERRIDES
# =============================================================================
# Database URL for development/testing
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/unit_talk_dev

# Pooler URL for database connections (Supabase specific)
SUPABASE_DB_URL_POOLER=postgresql://postgres.your-project:your_password@aws-region.pooler.supabase.com:5432/postgres?pgbouncer=true

# =============================================================================
# ENVIRONMENT-SPECIFIC NOTES
# =============================================================================
# Development:
# - Use localhost URLs for all services
# - Enable debug logging
# - Disable rate limiting for easier testing
#
# Staging:
# - Use staging database and services
# - Enable some monitoring but reduce retention
# - Use test API keys where possible
#
# Production:
# - Use production database and services
# - Enable all monitoring and alerting
# - Use production API keys and secure secrets
# - Enable all security features
# =============================================================================