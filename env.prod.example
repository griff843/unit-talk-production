# Production environment example
# These values should be set in production environment/secrets management
# NEVER commit actual production values to version control

# =============================================================================
# API & HEALTH CONFIGURATION
# =============================================================================
API_READINESS_URL=https://api.example.com/health/ready  # <fill-me from infrastructure>

# =============================================================================
# TEMPORAL CONFIGURATION
# =============================================================================
TEMPORAL_ADDRESS=temporal.prod.local:7233               # <fill-me e.g., temporal.prod.local:7233>
TEMPORAL_NAMESPACE=unit-talk-prod                       # <fill-me e.g., unit-talk-prod>
# TEMPORAL_HEALTH_URL=                                  # <leave-blank-or-not-used>

# =============================================================================
# DISCORD CANARY CONFIGURATION
# =============================================================================
CANARY_CHANNEL_ID=1296531122234327100                  # <numeric-id from Discord channel>

# =============================================================================
# TENANT / TAGGING
# =============================================================================
ORG_ID=prod
CANARY_TAG=claude-ci

# =============================================================================
# SUPABASE CONFIGURATION (Required)
# =============================================================================
SUPABASE_URL=<existing>
SUPABASE_ANON_KEY=<existing>
SUPABASE_SERVICE_ROLE_KEY=<existing>

# =============================================================================
# NOTE: Other production secrets should be managed through your secrets system
# =============================================================================