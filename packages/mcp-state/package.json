{
  "name": "@unit-talk/mcp-state",
  "version": "0.0.1",
  "description": "MCP server exposing pick lifecycle state, outbox depth, and settlement status for Unit Talk",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mcp-state": "dist/server.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "state",
    "picks",
    "lifecycle",
    "outbox"
  ],
  "author": "Unit Talk Team",
  "license": "PROPRIETARY",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@supabase/supabase-js": "^2.39.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "files": [
    "dist/**/*",
    "src/**/*"
  ]
}
