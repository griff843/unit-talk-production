{
  "name": "@unit-talk/shared-types",
  "version": "1.0.0",
  "description": "Shared TypeScript types for Unit Talk Platform",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "typescript",
    "types",
    "shared"
  ],
  "author": "Unit Talk Team",
  "license": "PROPRIETARY",
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
