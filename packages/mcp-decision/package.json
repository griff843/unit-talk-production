  "description": "MCP server exposing LLM routing decisions, sprint gates, and finding backlog for Unit Talk Claude OS",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mcp-decision": "dist/server.js"
  },
  "scripts": {
    "build": "tsc",
