{
  "name": "@unit-talk/telemetry",
  "version": "1.0.0",
  "description": "OpenTelemetry instrumentation for Unit Talk Platform",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "telemetry",
    "opentelemetry",
    "monitoring"
  ],
  "author": "Unit Talk Team",
  "license": "PROPRIETARY",
  "dependencies": {
    "@opentelemetry/api": "^1.7.0",
    "@opentelemetry/sdk-node": "^0.45.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.45.0",
    "@opentelemetry/instrumentation": "^0.45.0",
    "@opentelemetry/instrumentation-http": "^0.45.0",
    "@opentelemetry/instrumentation-express": "^0.34.0",
    "@opentelemetry/instrumentation-pg": "^0.37.0",
    "@opentelemetry/instrumentation-redis": "^0.35.0",
    "@opentelemetry/instrumentation-winston": "^0.32.0",
    "@opentelemetry/semantic-conventions": "^1.17.0",
    "@opentelemetry/resources": "^1.17.0",
    "@opentelemetry/propagator-b3": "^1.17.0",
    "@opentelemetry/propagator-jaeger": "^1.17.0"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "@types/node": "^20.10.0"
  }
}