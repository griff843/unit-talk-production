{
  "name": "@unit-talk/database",
  "version": "1.0.0",
  "description": "Shared database utilities and migrations for Unit Talk Platform",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc --watch",
    "clean": "rimraf dist",
    "test": "jest",
    "type-check": "tsc --noEmit",
    "migrate": "node dist/migrate.js"
  },
  "keywords": [
    "database",
    "supabase",
    "postgresql",
    "migrations"
  ],
  "author": "Unit Talk Team",
  "license": "PROPRIETARY",
  "dependencies": {
    "@unit-talk/shared-types": "^1.0.0",
    "@unit-talk/shared-utils": "^1.0.0",
    "@supabase/supabase-js": "^2.0.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "jest": "^29.0.0",
    "@types/jest": "^29.0.0"
  },
  "files": [
    "dist"
  ]
}
