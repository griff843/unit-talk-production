{
  "name": "@unit-talk/platform",
  "version": "1.0.0",
  "description": "Unit Talk - Fortune 100-grade sports betting intelligence platform",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check-env": "npx tsx scripts/check-dev-env.ts",
    "clean:next": "rm -rf apps/command-center/.next apps/smart-form/.next apps/dashboard/.next",
    "prebuild": "npm run check-env",
    "build": "npm run build --workspaces",
    "dev": "npm run dev --workspaces",
    "test": "npm run test --workspaces",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "format:check": "prettier --check \"apps/*/src/**/*.{ts,tsx}\" \"apps/*/app/**/*.{ts,tsx}\" \"apps/*/components/**/*.{ts,tsx}\" \"apps/*/lib/**/*.{ts,tsx}\" \"packages/*/src/**/*.{ts,tsx}\"",
    "format:write": "prettier --write \"apps/*/src/**/*.{ts,tsx}\" \"apps/*/app/**/*.{ts,tsx}\" \"apps/*/components/**/*.{ts,tsx}\" \"apps/*/lib/**/*.{ts,tsx}\" \"packages/*/src/**/*.{ts,tsx}\"",
    "lint": "pnpm -r run lint",
    "lint:prod": "npm run lint:prod --workspaces --if-present",
    "type-check": "npm run type-check --workspaces --if-present",
    "clean": "npm run clean --workspaces && rm -rf node_modules",
    "start:api": "npm run start --workspace=apps/api",
    "start:discord-bot": "npm run start --workspace=apps/discord-bot",
    "start:dashboard": "npm run dev --workspace=apps/dashboard",
    "start:smart-form": "npm run dev --workspace=apps/smart-form",
    "start:command-center": "npm run dev --workspace=apps/command-center",
    "env:audit": "npx tsx scripts/ops/env-audit.ts",
    "ops:env:check": "npx tsx scripts/ops/env-check.ts",
    "ops:build:matrix": "npx tsx scripts/ops/build-matrix.ts",
    "ops:ci:gate": "npx tsx scripts/ops/ci-gate.ts",
    "cc:no-mocks": "npx tsx scripts/ops/cc-no-mocks.ts",
    "clock:no-wall-time": "node scripts/clock-no-wall-time.mjs",
    "replay:run": "pnpm --filter api replay:run",
    "shadow:run": "pnpm --filter './apps/api' run shadow:run",
    "shadow:guardrails": "pnpm --filter './apps/api' run shadow:guardrails",
    "cc:build-sanitized": "npx tsx scripts/ops/cc-build-sanitized.ts",
    "deploy:validate-paths": "npx tsx scripts/ops/deploy-validate-paths.ts",
    "docs:validate": "node scripts/validate-documentation.js",
    "docs:generate": "node scripts/generate-docs.js",
    "setup": "npm install && npm run build",
    "dev:all": "bash dev.sh start",
    "dev:stop": "bash dev.sh stop",
    "dev:restart": "bash dev.sh restart",
    "dev:logs": "bash dev.sh logs",
    "dev:status": "bash dev.sh status",
    "dev:clean": "bash dev.sh clean",
    "dev:reset": "bash dev.sh reset",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:ps": "docker-compose ps",
    "health:check": "bash scripts/health-check.sh",
    "alerts:test": "bash scripts/test-alerts.sh",
    "db:reset": "bash scripts/reset-database.sh",
    "prepare": "husky",
    "ops:health": "node tools/run-ops.mjs health",
    "ops:restart": "node tools/run-ops.mjs restart",
    "ops:bootstrap": "node tools/run-ops.mjs bootstrap",
    "verify:merge": "npx tsx scripts/verify-merge-readiness.ts",
    "verify:ops-submit": "npm run type-check --workspace=apps/api && npm run verify:ops-submit --workspace=apps/command-center",
    "verify:sprint": "npx tsx scripts/verify-sprint.ts",
    "sprint:validate": "npx tsx scripts/sprint-close.ts --validate-only",
    "sprint:close": "npx tsx scripts/sprint-close.ts",
    "phase:proof": "npx tsx scripts/generate-phase-proof.ts",
    "guard:lockfiles": "npx tsx scripts/guard-no-npm-lock.ts",
    "guard:supabase-endpoint": "node scripts/assert-no-stale-supabase.mjs",
    "guard:env": "node scripts/guard-env-proliferation.mjs",
    "guard:env:warn": "node scripts/guard-env-proliferation.mjs --warn",
    "schema:types:gen": "node scripts/generate-schema-types.mjs",
    "schema:check-drift": "node scripts/guard-schema-drift.mjs",
    "schema:verify": "npm run schema:types:gen && npm run schema:check-drift",
    "guard:db-type-drift": "node scripts/guard-db-type-drift.mjs",
    "guard:db-type-drift:strict": "node scripts/guard-db-type-drift.mjs --strict",
    "guard:canonical": "node scripts/guard-canonical-unified-only.mjs",
    "guard:canonical:strict": "node scripts/guard-canonical-unified-only.mjs --strict",
    "quarantine:governance": "node scripts/quarantine-governance-gate.mjs",
    "build:sanity": "node scripts/build-sanity.mjs",
    "ops:day": "node ops/day.mjs",
    "session:baseline": "node scripts/claude-session-baseline.mjs",
    "pre-sprint-check": "node scripts/pre-sprint-check.mjs",
    "sprint:gate": "node tools/governance/sprint-gate.js",
    "sprint:gate:036": "node tools/governance/sprint-gate.js SPRINT-036",
    "mcp:eslint": "node scripts/mcp-wrappers/eslint-mcp.mjs",
    "mcp:git": "node scripts/mcp-wrappers/git-mcp.mjs",
    "mcp:workspace": "node scripts/mcp-wrappers/pnpm-workspace-mcp.mjs",
    "mcp:supabase": "node scripts/mcp-wrappers/supabase-schema-mcp.mjs",
    "mcp:typescript": "node scripts/mcp-wrappers/typescript-lsp-mcp.mjs",
    "e2e:smoke:full": "npx tsx scripts/e2e-smoke/run-full-smoke.ts",
    "huly-os:report:dry-run": "pnpm --filter @unit-talk/huly-os report:dry-run",
    "huly-os:report:run": "pnpm --filter @unit-talk/huly-os report:run",
    "huly-os:huly:smoke": "pnpm --filter @unit-talk/huly-os huly:smoke",
    "huly-os:up": "docker compose -f tools/huly-os/docker/compose.yml up -d",
    "huly-os:down": "docker compose -f tools/huly-os/docker/compose.yml down"
  },
  "keywords": [
    "sports-betting",
    "analytics",
    "discord-bot",
    "temporal",
    "typescript",
    "fortune-100"
  ],
  "author": "Unit Talk Team",
  "license": "PROPRIETARY",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^20.4.2",
    "@supabase/supabase-js": "^2.49.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.9",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "concurrently": "^8.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-security": "^3.0.1",
    "js-yaml": "^4.1.0",
    "lint-staged": "^16.1.4",
    "pg": "^8.18.0",
    "prettier": "^3.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.6.0",
    "typescript": "^5.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix --ignore-pattern 'apps/command-center/src/types/database*.ts' --ignore-pattern 'apps/command-center/src/types/index.ts' --ignore-pattern 'apps/api/test/__quarantine__/**' --ignore-pattern 'apps/api/scripts/**'"
    ],
    "*.{js,jsx}": [
      "prettier --write",
      "eslint --fix --ignore-pattern 'apps/api/scripts/**'"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.1",
    "zod": "^4.0.15"
  },
  "overrides": {
    "path-scurry": {
      "lru-cache": "^10.2.0"
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@swc/core",
      "protobufjs"
    ]
  }
}
