{
  "name": "unit-talk-platform",
  "version": "1.0.0",
  "description": "Enterprise-grade betting automation platform",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --project tsconfig.prod.json",
    "build:watch": "tsc --watch",
    "start": "node dist/index.js",
    "start:dev": "tsx src/index.ts",
    "worker": "tsx src/worker.ts",
    "worker:start": "tsx src/worker.ts",
    "worker:dev": "tsx --watch src/worker.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --testPathPattern=integration",
    "test:unit": "jest --testPathPattern=unit",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json}\"",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "metrics:show": "node scripts/showMetrics.js",
    "health:check": "node scripts/healthCheck.js",
    "agents:test": "tsx src/runner/testAllAgents.ts",
    "agents:recap": "tsx src/runner/recapAgentTestHarness.ts",
    "agents:feed": "tsx src/runner/feedAgentTestHarness.ts",
    "agents:optimal": "tsx src/runner/optimalIngestionTest.ts",
    "enrich-players": "tsx src/scripts/enrichPlayerHeadshots.ts",
    "enrich:test": "tsx src/agents/PlayerEnrichmentAgent/manual-test.ts",
    "enrich:multi-league": "tsx src/agents/PlayerEnrichmentAgent/multi-league-test.ts",
    "clean": "rimraf dist",
    "clean:install": "rimraf node_modules package-lock.json && npm install",
    "docker:build": "docker build -t unit-talk-platform .",
    "docker:run": "docker run -p 3000:3000 unit-talk-platform",
    "prepare": "husky install",
    "qa:staging": "QA_ENVIRONMENT=staging tsx qa/run-launch-qa.ts",
    "qa:production": "QA_ENVIRONMENT=production tsx qa/run-launch-qa.ts",
    "qa:local": "QA_ENVIRONMENT=local tsx qa/run-launch-qa.ts",
    "qa:launch": "tsx qa/run-launch-qa.ts",
    "qa:e2e": "playwright test",
    "qa:e2e:ui": "playwright test --ui",
    "qa:e2e:headed": "playwright test --headed",
    "qa:accessibility": "tsx qa/tests/accessibility.test.ts",
    "qa:security": "tsx qa/tests/security.test.ts",
    "qa:mobile": "tsx qa/tests/mobile.test.ts",
    "qa:performance": "tsx qa/tests/performance.test.ts",
    "qa:user-tiers": "tsx qa/tests/user-tiers.test.ts",
    "qa:workflows": "tsx qa/tests/workflows.test.ts",
    "qa:install": "playwright install",
    "qa:report": "tsx qa/utils/generate-report.ts",
    "qa:dashboard": "tsx qa/utils/launch-dashboard.ts",
    "qa:full": "npm run qa:e2e && npm run qa:accessibility && npm run qa:security && npm run qa:mobile && npm run qa:performance && npm run qa:report",
    "syndicate:start": "tsx src/scripts/start-syndicate.ts",
    "syndicate:pause": "kill -USR1 $(pgrep -f start-syndicate)",
    "syndicate:resume": "kill -USR2 $(pgrep -f start-syndicate)",
    "syndicate:stop": "kill -TERM $(pgrep -f start-syndicate)",
    "syndicate:status": "curl -s http://localhost:9091/health | jq .",
    "syndicate:schedules": "curl -s http://localhost:9091/schedules | jq .",
    "syndicate:metrics": "curl -s http://localhost:9090/metrics",
    "test:e2e-local": "tsx src/scripts/e2e-test-runner.ts",
    "test:e2e-external": "tsx src/scripts/e2e-test-runner-external-worker.ts",
    "test:temporal": "tsx src/scripts/temporal-test-runner.ts",
    "test:env-validate": "tsx src/scripts/test-env-validator.ts",
    "test:e2e-basic": "TEST_SCENARIO=basic tsx src/scripts/e2e-test-runner.ts",
    "test:e2e-comprehensive": "TEST_SCENARIO=comprehensive tsx src/scripts/e2e-test-runner.ts",
    "test:e2e-stress": "TEST_SCENARIO=stress tsx src/scripts/e2e-test-runner.ts",
    "test:workflows-only": "tsx src/scripts/temporal-test-runner.ts",
    "test:validate-setup": "tsx src/scripts/test-env-validator.ts && echo 'Environment validation complete'",
    "test:full-pipeline": "npm run test:env-validate && npm run test:temporal && npm run test:e2e-local",
    "dev:setup": "tsx src/scripts/setup-local-dev.ts",
    "dev:start": "tsx src/scripts/start-services.ts",
    "dev:services": "docker compose up -d postgres redis temporal temporal-web",
    "dev:stop": "docker compose down",
    "dev:logs": "docker compose logs -f",
    "dev:status": "docker compose ps"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.56.0",
    "@notionhq/client": "^2.2.15",
    "@supabase/supabase-js": "^2.50.0",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-query-devtools": "^5.83.0",
    "@temporalio/activity": "^1.8.0",
    "@temporalio/client": "^1.8.0",
    "@temporalio/worker": "^1.8.0",
    "@temporalio/workflow": "^1.8.0",
    "@types/express-rate-limit": "^5.1.3",
    "axios": "^1.9.0",
    "date-fns": "^3.6.0",
    "discord.js": "^14.14.1",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "gpt-tokenizer": "^3.0.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.6.1",
    "luxon": "^3.6.1",
    "next-themes": "^0.4.6",
    "node-cron": "^3.0.3",
    "openai": "^4.103.0",
    "pino": "^8.21.0",
    "pino-pretty": "^10.3.1",
    "prom-client": "^15.1.3",
    "react-virtualized": "^9.22.6",
    "recharts": "^3.1.0",
    "redis": "^4.7.0",
    "twilio": "^4.23.0",
    "uuid": "^10.0.0",
    "web-vitals": "^5.0.3",
    "zod": "^3.25.56"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.8.5",
    "@playwright/test": "^1.40.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^4.17.23",
    "@types/glob": "^8.1.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.6.2",
    "@types/node": "^20.19.8",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "@types/uuid": "^10.0.0",
    "@types/winston": "^2.4.4",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "axe-core": "^4.8.3",
    "cypress": "^14.5.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "glob": "^11.0.3",
    "husky": "^9.1.6",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.0.4",
    "lighthouse": "^11.4.0",
    "lint-staged": "^15.2.10",
    "nodemailer": "^7.0.3",
    "pa11y": "^8.0.0",
    "playwright": "^1.40.0",
    "prettier": "^3.5.3",
    "puppeteer": "^21.6.1",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.6.0",
    "typescript": "^5.8.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "private": true,
  "license": "UNLICENSED",
  "keywords": [
    "betting",
    "automation",
    "sports",
    "typescript",
    "temporal",
    "supabase",
    "enterprise"
  ],
  "repository": {
    "type": "git",
    "url": "private"
  },
  "bugs": {
    "url": "private"
  },
  "homepage": "private"
}
