{
  "name": "@unit-talk/platform",
  "version": "1.0.0",
  "description": "Unit Talk - Fortune 100-grade sports betting intelligence platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:api": "npm run build --workspace=apps/api",
    "build:smart-form": "npm run build --workspace=apps/smart-form",
    "dev": "npm run dev --workspaces",
    "test": "npm run test --workspaces",
    "test:unit": "npm run test:unit --workspace=apps/api",
    "test:api": "npm run test --workspace=apps/api",
    "lint": "npm run lint --workspaces",
    "type-check": "npm run type-check --workspaces",
    "type-check:api": "npm run type-check --workspace=apps/api",
    "clean": "npm run clean --workspaces && rm -rf node_modules",
    "clean:api": "npm run clean --workspace=apps/api",
    "start:api": "npm run start --workspace=apps/api",
    "start:discord-bot": "npm run start --workspace=apps/discord-bot",
    "start:dashboard": "npm run dev --workspace=apps/dashboard",
    "start:smart-form": "npm run dev --workspace=apps/smart-form",
    "start:command-center": "npm run dev --workspace=apps/command-center",
    "docs:validate": "node scripts/validate-documentation.js",
    "docs:generate": "node scripts/generate-docs.js",
    "setup": "npm install && npm run build",
    "dev:all": "bash dev.sh start",
    "dev:stop": "bash dev.sh stop",
    "dev:restart": "bash dev.sh restart",
    "dev:logs": "bash dev.sh logs",
    "dev:status": "bash dev.sh status",
    "dev:clean": "bash dev.sh clean",
    "dev:reset": "bash dev.sh reset",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:ps": "docker-compose ps",
    "health:check": "bash scripts/health-check.sh",
    "alerts:test": "bash scripts/test-alerts.sh",
    "db:reset": "bash scripts/reset-database.sh",
    "ops:verify": "node apps/api/src/scripts/verify-gates.ts && node apps/api/src/scripts/verify-slo.ts",
    "ops:monitor": "npx tsx scripts/ops/monitor-cutover.ts",
    "ops:monitor:once": "npx tsx scripts/ops/monitor-cutover.ts --once",
    "ops:check-project": "npx tsx scripts/ops/check-project-alignment.ts",
    "ops:ensure-reload": "npx tsx scripts/ops/ensure-migration-reload.ts",
    "ops:reload-pgrst": "npx tsx scripts/ops/force-postgrest-reload.ts",
    "ops:verify-pgrst": "npx tsx scripts/ops/verify-pgrst-visible.ts",
    "ops:rls:enable": "npx tsx scripts/ops/enable-rls.ts",
    "ops:pgrst:reload": "npx tsx scripts/ops/run-pgrst-reload.ts",
    "ops:phase15:run": "node scripts/ops/phase15-orchestrator.js",
    "ops:phase15:dry-run": "node scripts/ops/phase15-orchestrator.js --dry-run",
    "ops:phase15:parallel": "node scripts/ops/phase15-orchestrator.js --parallel",
    "ops:seed-user": "node scripts/ops/seed-test-user.js",
    "ops:force-reload": "node scripts/ops/force-postgrest-reload.js",
    "ops:e2e": "node scripts/ops/phase13-manual-e2e.js",
    "ops:e2e:parallel": "node scripts/ops/phase13-manual-e2e.js --parallel",
    "audit:e2e": "npx tsx scripts/audit/phase16-e2e-validation.ts",
    "audit:performance": "npx tsx scripts/audit/phase16-performance-audit.ts",
    "audit:security": "npx tsx scripts/audit/phase16-security-audit.ts",
    "audit:master": "npx tsx scripts/audit/phase16-master-audit.ts",
    "audit:all": "npm run audit:master",
    "smoke:run": "npx tsx scripts/smoke/run-smoke.ts",
    "smoke:report": "npx tsx scripts/smoke/run-smoke.ts --report-only",
    "db:local:status": "docker-compose exec -T postgres psql -U postgres -d unit_talk_dev -c \"SELECT version, applied_at FROM schema_versions ORDER BY applied_at DESC LIMIT 5\" 2>/dev/null || echo 'schema_versions table not found'",
    "db:local:migrate": "bash -c 'for f in supabase/migrations/*.sql; do echo \"Applying $f...\"; docker-compose exec -T postgres psql -U postgres -d unit_talk_dev < \"$f\" 2>&1 | grep -v \"already exists\\|duplicate\"; done; echo \"✅ Migrations complete\"'",
    "db:local:tables": "docker-compose exec -T postgres psql -U postgres -d unit_talk_dev -c \"SELECT table_name FROM information_schema.tables WHERE table_schema = 'public' ORDER BY table_name\"",
    "prepare": "husky"
  },
  "keywords": [
    "sports-betting",
    "analytics",
    "discord-bot",
    "temporal",
    "typescript",
    "fortune-100"
  ],
  "author": "Unit Talk Team",
  "license": "PROPRIETARY",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.9",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "concurrently": "^8.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-security": "^3.0.1",
    "lint-staged": "^16.1.4",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.1",
    "zod": "^4.0.15"
  }
}
