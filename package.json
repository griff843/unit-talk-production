{
  "name": "@unit-talk/platform",
  "version": "1.0.0",
  "description": "Unit Talk - Fortune 100-grade sports betting intelligence platform",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run -ws build",
    "build:packages": "npm run -ws --if-present build",
    "build:api": "npm run build --workspace=@unit-talk/api",
    "dev": "npm run dev --workspaces",
    "test": "jest",
    "test:seeds": "jest --runInBand --detectOpenHandles",
    "lint": "npm run lint --workspaces",
    "type-check": "npm run type-check --workspaces",
    "clean": "npm run clean --workspaces && rm -rf node_modules",
    "start:api": "npm run -w @unit-talk/api start",
    "start:discord-bot": "npm run start --workspace=apps/discord-bot",
    "start:dashboard": "npm run dev --workspace=apps/dashboard",
    "start:smart-form": "npm run dev --workspace=apps/smart-form",
    "start:command-center": "npm run dev --workspace=apps/command-center",
    "docs:validate": "node scripts/validate-documentation.js",
    "docs:generate": "node scripts/generate-docs.js",
    "setup": "npm install && npm run build",
    "dev:all": "bash dev.sh start",
    "dev:stop": "bash dev.sh stop",
    "dev:restart": "bash dev.sh restart",
    "dev:logs": "bash dev.sh logs",
    "dev:status": "bash dev.sh status",
    "dev:clean": "bash dev.sh clean",
    "dev:reset": "bash dev.sh reset",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:ps": "docker-compose ps",
    "health:check": "bash scripts/health-check.sh",
    "alerts:test": "bash scripts/test-alerts.sh",
    "db:reset": "bash scripts/reset-database.sh",
    "db:reset:test": "ts-node scripts/db/reset-test.ts",
    "db:inventory": "ts-node scripts/db/inventory-schema.ts",
    "db:contracts": "psql -v ON_ERROR_STOP=1 -f scripts/db/verify-contracts.sql",
    "db:migrate:rawprops": "ts-node scripts/db/migrate-raw-props-to-unified.ts",
    "db:migrate:sgo": "supabase migration up",
    "db:ingest:sgo:live": "ts-node apps/worker/src/workflows/liveSportsGameOdds.ts --sports=all",
    "ops:green": "node scripts/ops/ops-green.js",
    "ops:env": "node scripts/ops/validate-env.js",
    "ops:watchdog": "npx tsx apps/api/src/scripts/ops/watchdogAgentHealth.ts",
    "ops:watchdog-start": "pm2 start apps/api/src/scripts/ops/watchdogAgentHealth.ts --name agent-watchdog --cron '*/2 * * * *' --no-autorestart",
    "ops:watchdog-stop": "pm2 stop agent-watchdog && pm2 delete agent-watchdog",
    "ops:watchdog-logs": "pm2 logs agent-watchdog",
    "ops:start-schedulers": "pm2 start apps/api/src/scripts/schedulers/liveLoops.ts --name unit-talk-schedulers --interpreter npx --interpreter-args \"tsx\" && pm2 save",
    "ops:stop-schedulers": "pm2 stop unit-talk-schedulers || true",
    "ops:restart-schedulers": "pm2 restart unit-talk-schedulers || true",
    "ops:logs-schedulers": "pm2 logs unit-talk-schedulers",
    "ops:watchdog": "npx tsx apps/api/src/scripts/ops/watchdogAgentHealth.ts",
    "ops:verify": "npx tsx apps/api/src/scripts/verify/verifyCommandCenter.ts",
    "ops:cleanup-plan": "npx tsx apps/api/src/scripts/generate-cleanup-plan.ts",
    "ops:mocks": "node scripts/ops/assert-no-mocks.js",
    "ops:e2e": "node scripts/e2e/prod-e2e.js",
    "ops:health": "ts-node scripts/ops/health-probe.ts",
    "ops:audits": "ts-node scripts/ops/run-audits.ts",
    "ops:probe": "ts-node scripts/ops/health-probe.ts",
    "ops:tier": "ts-node scripts/ops/db-tiering.ts",
    "ops:emit-dashboard": "ts-node scripts/ops/emit-dashboard.ts",
    "ops:current-state": "ts-node scripts/db/current-state.ts",
    "e2e:shadow": "ts-node scripts/e2e/shadow.ts",
    "e2e:canary": "ts-node scripts/e2e/canary.ts",
    "ops:rpc-check": "tsx -r dotenv/config apps/api/src/scripts/ops/rpc-check.ts",
    "ops:dump:unified_picks": "tsx -r dotenv/config apps/api/src/scripts/ops/dump-unified-picks.ts",
    "ops:dump:unified_picks:local": "tsx -r dotenv/config apps/api/src/scripts/ops/dump-unified-picks-local.ts",
    "e2e:smoke": "tsx -r dotenv/config apps/api/src/scripts/e2e/smoke.ts",
    "prep:ops": "npm run build:api && powershell -NoProfile -Command \"New-Item -ItemType Directory -Force out\\ops\\run-logs, out\\e2e-smoke | Out-Null\"",
    "db:overlay": "bash ./scripts/db_overlay_apply.sh",
    "db:verify": "bash ./scripts/db_verify.sh",
    "db:deploy-cloud": "bash ./scripts/db_deploy.sh",
    "ts:check": "npm run type-check --workspaces",
    "lint:fix": "npm run lint:fix --workspaces",
    "prepare": "husky"
  },
  "keywords": [
    "sports-betting",
    "analytics",
    "discord-bot",
    "temporal",
    "typescript",
    "fortune-100"
  ],
  "author": "Unit Talk Team",
  "license": "PROPRIETARY",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "@types/cypress": "^0.1.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.9",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "concurrently": "^8.0.0",
    "cypress": "^15.3.0",
    "discord.js": "^14.22.1",
    "dotenv": "^17.2.2",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-security": "^3.0.1",
    "jest": "^30.1.3",
    "lint-staged": "^16.1.4",
    "playwright": "^1.55.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.0.0"
  },
  "lint-staged": {
    "apps/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "packages/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "scripts/**/*.{ts,tsx}": [
      "prettier --write"
    ],
    "*.{js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "axios": "^1.12.2",
    "rss-parser": "^3.13.0",
    "zod": "^4.0.15"
  }
}