# ==============================================================================
# Fortune 100-Grade .gitignore for Unit Talk Production Platform
# ==============================================================================

# Node modules and package manager files
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
lerna-debug.log*
.yarn/
.pnp.*
.npm/

# Environment and configuration files
.env
.env.*
!.env.example
!.env.template
config/local.json
config/secrets.json
*.pem
*.key
*.crt
*.p12
*.pfx
.secrets/

# Build outputs and artifacts
dist/
build/
out/
.next/
.nuxt/
.output/
.vite/
.turbo/
*.tsbuildinfo
tsconfig.tsbuildinfo

# Development and testing
coverage/
.coverage/
.nyc_output/
test-results/
playwright-report/
playwright/.cache/
.cache/
tmp/
temp/
.tmp/
.temp/

# Logs and monitoring
logs/
*.log
log-*.txt
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
combined.log
error.log
exceptions.log
access.log
audit.log

# IDE and editor files
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Database files
*.sqlite
*.sqlite3
*.db
*.sql.backup
migrations/backup/

# Docker and containerization
.dockerignore
docker-compose.override.yml
.docker/

# Kubernetes secrets and configs
k8s/secrets/
k8s/config/local/
*.kubeconfig

# Terraform state and variables
terraform.tfstate
terraform.tfstate.backup
terraform.tfvars
terraform.tfvars.json
.terraform/
.terraform.lock.hcl

# Security and audit files
.audit/
security-scan-results/
.snyk
.sonar/

# Temporary files and backups
*.tmp
*.temp
*.bak
*.backup
*.old
*.orig
*.swp
*.swo
*~

# Performance and profiling
.clinic/
*.cpuprofile
*.heapprofile
*.heapsnapshot

# CI/CD artifacts
.github/secrets/
.circleci/config.local.yml
.travis.local.yml
jenkins/secrets/

# Application-specific ignores
# =============================

# Discord Bot specific
unit-talk-custom-bot/logs/
unit-talk-custom-bot/.env
unit-talk-custom-bot/config/local.json

# Smart Form specific
"unit-talk-smart form"/.env.local
"unit-talk-smart form"/.vercel
"unit-talk-smart form"/build/

# Frontend specific
unit-talk-frontend/.env.local
unit-talk-frontend/.vercel
unit-talk-frontend/build/

# Command Center specific
apps/command-center/.env.local
apps/command-center/.vercel
apps/command-center/build/

# Backend specific
src/config/local.json
src/keys/
worker/logs/

# Package-specific ignores
# ========================

# Shared packages build outputs
packages/*/dist/
packages/*/build/
packages/*/lib/
packages/*/.turbo/

# Documentation build outputs
docs/build/
docs/.docusaurus/
docs/node_modules/

# Infrastructure generated files
infrastructure/generated/
infrastructure/secrets/
infrastructure/*.tfstate*

# Scripts generated files
scripts/logs/
scripts/output/
scripts/temp/

# Tools generated files
tools/build/
tools/dist/
tools/.cache/

# Monitoring and observability
prometheus/data/
grafana/data/
elasticsearch/data/
kibana/data/

# Development utilities
.history/
.vscode-test/
.pytest_cache/
__pycache__/
*.pyc
*.pyo
*.pyd

# Package lock files (keep main one, ignore workspace specific)
# package-lock.json  # Keep main workspace lock
apps/*/package-lock.json
packages/*/package-lock.json

# Local development overrides
docker-compose.local.yml
k8s/local/
.local/

# Miscellaneous
*.pid
*.seed
*.pid.lock
.grunt
bower_components/
.lock-wscript
.eslintcache
.stylelintcache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/
.wireit/

# ==============================================================================
# ARTIFACT QUARANTINE - Generated outputs should NEVER be committed
# ==============================================================================

# Generated artifacts and proof bundles
out/
artifacts/
_quarantine/
analytics/

# Proof bundles and phase artifacts (root level only)
/*_SUMMARY.md
/*_PROOF_BUNDLE.md
/*_REPORT.md
/*_FINDINGS.md
/*_VERDICT.md
/*_STATUS.md
/*_SPEC.md
/*_EVIDENCE.md
/*_PLAN.md
/*_GUIDE.md
/*_CHECKLIST.md
/*_COMPLETE.md
/*_README.md
/*_READY.md
/*_DECISION.json
/*_TEMPLATE.json
PHASE*.md
PHASE*.txt
PHASE*.json
CANARY*.md
SMOKE*.txt
RUN*.md
EXECUTE*.md
GO_NO_GO*.md
LIVE_FIRE*.md
APPLY_MIGRATIONS*.sql

# Test output files (root level)
/*.txt
/*.log
smoke-pack*.txt
canary_e2e*.txt
test-*.txt
nul

# Migration and validation scripts (root level)
apply-*.ps1
apply-*.py
apply_migrations*.py
verify-*.ps1
verify-*.js
check-*.js
create-*.ps1
promote-*.ps1
execute-*.ps1
test-*.ps1
phase*-*.sql

# PowerShell and Python scripts (root level - generated)
/*.ps1
/*.py
!scripts/**/*.ps1
!scripts/**/*.py
!infrastructure/**/*.ps1

# Generated SQL at root
/*.sql
!supabase/migrations/*.sql

# JSON artifacts at root
pgrst_reload_result.json
temp_token.txt

# Pre-commit configs (if not intentional)
.pre-commit-config.yaml

# App-level generated artifacts
apps/*/PHASE*.md
apps/*/APPLY*.md
apps/*/EXECUTE*.md
apps/*/*-output.txt
apps/*/smoke-*.txt
apps/*/audit-*.ps1
apps/*/verify-*.ps1
apps/*/apply-*.ps1
apps/*/run-*.ps1
apps/*/execute-*.ps1
apps/*/phase*-evidence/
apps/*/config/
apps/*/supabase/migrations/

# App-specific SQL/migration files (unless intentional)
apps/*/CONSOLIDATED_MIGRATION*.sql
apps/*/MIGRATION*.sql
apps/*/*.sql
!apps/*/src/**/*.sql

# App-specific test outputs
apps/*/smoke-pack*.txt
apps/*/test-results/
apps/*/playwright-report/
apps/*/tests/screenshots/
apps/*/tests/*-output.txt

# Shared package generated files
apps/shared/
packages/*/src/**/*.d.ts
packages/*/src/**/*.d.ts.map
packages/*/src/**/*.js
packages/*/src/**/*.js.map
!packages/*/src/**/*.test.js
!packages/*/src/**/*.spec.js

# Infrastructure generated configs
infra/
infrastructure/argocd/apps/
infrastructure/argocd/bootstrap/
infrastructure/argocd/projects/
infrastructure/dashboards/
infrastructure/doks/
infrastructure/kubernetes/apps/*/
!infrastructure/kubernetes/apps/.gitkeep

# Monitoring data
monitoring/alertmanager/
monitoring/grafana/dashboards/
monitoring/grafana/provisioning/
monitoring/prometheus/

# Scripts generated outputs
scripts/ops/windows/
scripts/audit/
scripts/burn-in/
scripts/chaos/
scripts/load/
scripts/perf/
scripts/migrations/
scripts/production-cutover/

# Docs generated files (proof packs, not actual docs)
docs/*/PHASE*.md
docs/*/PROOF*.md
docs/*/APPLY*.md
docs/*/EXECUTE*.md
docs/ai/
docs/analytics/
docs/audit/
docs/modernization/
docs/partners/

# Keep intentional docs/ops files, exclude generated ones
!docs/ops/*.md
docs/ops/phase*-*.ps1
docs/ops/verify-*.ps1
docs/ops/apply-*.ps1

# Test and E2E artifacts
tests/e2e/
canary_e2e_output.txt
test-env-loading.js
verify-env-phase*.js

# Config generated files
config/*.d.ts
config/*.d.ts.map
config/*.js
config/*.js.map
!config/**/*.config.js
