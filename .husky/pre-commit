#!/bin/sh
echo "🔍 Running pre-commit checks..."

# Documentation validation
echo "📚 Validating documentation..."
npm run docs:validate

# Lint and format staged files only (much faster)
echo "🧹 Running lint-staged..."
npx lint-staged

# TypeScript check only if .ts or .tsx files are staged
# Run type-check only on workspaces with staged TypeScript files (more targeted)
STAGED_TS_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx)$' || true)

if [ -n "$STAGED_TS_FILES" ]; then
  echo "🔧 Running TypeScript checks (TypeScript files detected)..."
  # Determine which workspaces have staged files
  STAGED_WORKSPACES=""
  if echo "$STAGED_TS_FILES" | grep -q "^apps/api/"; then
    STAGED_WORKSPACES="$STAGED_WORKSPACES -w apps/api"
  fi
  if echo "$STAGED_TS_FILES" | grep -q "^apps/smart-form/"; then
    STAGED_WORKSPACES="$STAGED_WORKSPACES -w apps/smart-form"
  fi
  if echo "$STAGED_TS_FILES" | grep -q "^apps/command-center/"; then
    STAGED_WORKSPACES="$STAGED_WORKSPACES -w apps/command-center"
  fi
  if echo "$STAGED_TS_FILES" | grep -q "^apps/discord-bot/"; then
    STAGED_WORKSPACES="$STAGED_WORKSPACES -w apps/discord-bot"
  fi
  if echo "$STAGED_TS_FILES" | grep -q "^apps/dashboard/"; then
    STAGED_WORKSPACES="$STAGED_WORKSPACES -w apps/dashboard"
  fi
  if echo "$STAGED_TS_FILES" | grep -q "^packages/"; then
    STAGED_WORKSPACES="$STAGED_WORKSPACES -w packages/config -w packages/database -w packages/shared-utils -w packages/shared-types"
  fi
  if echo "$STAGED_TS_FILES" | grep -q "^scripts/"; then
    # Root scripts - run root type-check only
    npm run type-check -w apps/api 2>/dev/null || true
  fi

  if [ -n "$STAGED_WORKSPACES" ]; then
    echo "🔧 Type-checking workspaces:$STAGED_WORKSPACES"
    npm run type-check $STAGED_WORKSPACES
  else
    echo "⏭️  No workspace TypeScript files staged, skipping type-check"
  fi
else
  echo "⏭️  Skipping TypeScript checks (no .ts/.tsx files staged)"
fi

echo "✅ All pre-commit checks passed!"
