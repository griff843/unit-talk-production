#!/bin/sh
echo "🔍 Running pre-commit checks..."

# Documentation validation
echo "📚 Validating documentation..."
npm run docs:validate

# Lint and format staged files only (much faster)
echo "🧹 Running lint-staged..."
npx lint-staged

# TypeScript check only if .ts or .tsx files are staged
STAGED_TS_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx)$' || true)

if [ -n "$STAGED_TS_FILES" ]; then
  echo "🔧 Running TypeScript checks (TypeScript files detected)..."
  npm run type-check
else
  echo "⏭️  Skipping TypeScript checks (no .ts/.tsx files staged)"
fi

echo "✅ All pre-commit checks passed!"
